# aunt-mabel-web environment template.
#
# Copy to `.env.local` and fill in real values from Bitwarden. `.env.local` is
# gitignored — never commit real keys. This file holds PLACEHOLDER NAMES ONLY.
#
# Anything prefixed PUBLIC_ is inlined at build time and shipped to the browser.
# The Supabase ANON key is safe to expose: it can only do what RLS policies
# allow. The SERVICE ROLE key is NEVER used here — it belongs in a Worker
# secret, never in a browser bundle.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The calling engine's public base URL (no trailing slash). Not a secret — it is
# a public API host — but it is CONFIG, so it never gets hardcoded in a page.
PUBLIC_ENGINE_URL=https://aunt-mabel-engine.example.workers.dev

