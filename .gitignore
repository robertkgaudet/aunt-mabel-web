# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# environment — real keys live in Bitwarden and Cloudflare Pages settings,
# never in the repo. Only .env.example (placeholders) is committed.
.env
.env.local
.env.test
# ...except the staging build config, which holds only a public engine URL and
# MUST travel with the repo. Without it a test build falls back to .env.local
# and quietly points staging at the production engine — the live-money bug.
!.env.test
.env.production

# wrangler
.wrangler/

# editor
.vscode/
.idea/
.DS_Store
*.swp
