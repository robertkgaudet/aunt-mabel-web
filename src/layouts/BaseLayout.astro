---
// Public shell for aunt-mabel-web — plain CSS, no Bootstrap, no jQuery.
// The Homer admin area under /homer/ uses src/layouts/homer/* instead; the
// two shells never appear on the same page.
//
// Header and footer reproduce the real auntmabel.app chrome (logo lockup +
// Ground Force tag; two-line footer). See docs/brand-capture.md.
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** Set true for auth pages and anything that should stay out of search. */
  noindex?: boolean;
  /** Drop the nav on focused pages (login, callback, signout). */
  bare?: boolean;
}

const {
  title,
  description = 'A friendly call every day — and a knock on the door when disaster strikes.',
  noindex = false,
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#c25b50" />
    <meta name="author" content="Cajun Navy Ground Force" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Brand faces — same single request as the live auntmabel.app page.
         Fraunces for headings/prose, Libre Franklin for body.
         See docs/brand-capture.md. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,900&family=Libre+Franklin:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:site_name" content="Aunt Mabel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {/* NOTE: no og:image. The live site points at /og-image.jpg, which 404s
         there — so there is nothing to copy. Adding the tag without the file
         would ship a knowingly-broken share preview. See docs/brand-capture.md. */}

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand-lockup" href="/">
          <img
            class="mark"
            src="/logo.png"
            width="46"
            height="46"
            alt="Aunt Mabel"
            decoding="async"
          />
          <span class="brand-text">
            <span class="nm">Aunt Mabel</span>
            <span class="sub">Everyday calls · disaster check-ins</span>
          </span>
        </a>

        <div class="header-right">
          <span class="gf-tag"><span class="dot"></span> A project of Cajun Navy Ground Force</span>
          {!bare && (
            <nav class="site-nav">
              <a href="/login">Sign in</a>
            </nav>
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p>
          Aunt Mabel is a project of <span class="gf">Cajun Navy Ground Force</span>
          — protecting and stabilizing the elderly and vulnerable.
        </p>
        <p class="fine">© 2026 · A call every day, and a knock on the door when it matters most.</p>
      </div>
    </footer>
  </body>
</html>
