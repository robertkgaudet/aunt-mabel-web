---
// Public shell for aunt-mabel-web — plain CSS, no Bootstrap, no jQuery.
// The Homer admin area under /homer/ uses src/layouts/homer/* instead; the
// two shells never appear on the same page.
//
// Header and footer reproduce the real auntmabel.app chrome (logo lockup +
// Ground Force tag; two-line footer). See docs/brand-capture.md.
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  /** Set true for auth pages and anything that should stay out of search. */
  noindex?: boolean;
  /** Drop the nav on focused pages (login, callback, signout). */
  bare?: boolean;
  /**
   * Social copy, when it should differ from the page title/description.
   *
   * A <title> earns its place in a search result and carries the product name;
   * a share card is read at a glance in a feed and wants the human sentence.
   * Optional — omit and the page title/description are used.
   */
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description = 'A friendly call every day — and a knock on the door when disaster strikes.',
  noindex = false,
  bare = false,
  ogTitle,
  ogDescription,
} = Astro.props;

const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

// Absolute, because Facebook and X will not resolve a relative one.
const ogImage = new URL('/og-image.jpg', Astro.site).href;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#c25b50" />
    {/* The OPERATOR, per docs/AUNT-MABEL.md § Entity & naming. Cajun Navy
        Ground Force is the partner performing disaster checks; naming it as
        author here would imply the nonprofit runs the service. */}
    <meta name="author" content="Trustlight LLC" />

    {/* Service is US-wide; Louisiana is where it is operated from. Kept light
        on purpose — over-localising would suppress us outside the state. */}
    <meta name="geo.region" content="US-LA" />
    <meta name="geo.placename" content="Louisiana" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Brand faces — same single request as the live auntmabel.app page.
         Fraunces for headings/prose, Libre Franklin for body.
         See docs/brand-capture.md. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,900&family=Libre+Franklin:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:site_name" content="Aunt Mabel" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {/* The card is real now — built from scripts/og-image.html by
        scripts/build-og-image.mjs and committed as public/og-image.jpg. The
        note that used to sit here said there was deliberately no og:image
        because the file 404'd; shipping the tag without the file would have
        meant a knowingly-broken preview. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aunt Mabel — a friendly call every day, and someone there when it matters most." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand-lockup" href="/">
          <img
            class="mark"
            src="/logo.png"
            width="46"
            height="46"
            alt="Aunt Mabel"
            decoding="async"
          />
          <span class="brand-text">
            <span class="nm">Aunt Mabel</span>
            <span class="sub">Everyday calls · disaster check-ins</span>
          </span>
        </a>

        <div class="header-right">
          {/* PARTNERSHIP, not operation. Aunt Mabel is operated by Trustlight
              LLC; Cajun Navy Ground Force is the disaster-response partner whose
              name we use by permission. Per docs/AUNT-MABEL.md § Entity &
              naming, brand-facing copy keeps the CNGF name — but nothing may
              imply the nonprofit runs this service or takes the payment. */}
          <span class="gf-tag"><span class="dot"></span> In partnership with Cajun Navy Ground Force</span>
          {!bare && (
            /* Starts in the "unknown" state and resolves client-side. Rendering
               "Sign in" by default would tell a signed-in person something
               untrue for a beat; blank-then-correct beats wrong-then-correct. */
            <nav class="site-nav" id="site-nav" data-auth="unknown">
              <a class="auth-out" href="/login">Sign in</a>
              <a class="auth-in" href="/dashboard">Your dashboard</a>
              <a class="auth-in auth-signout" href="/signout">Sign out</a>
            </nav>
          )}
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p>
          Aunt Mabel is operated by Trustlight LLC, in partnership with
          <span class="gf">Cajun Navy Ground Force</span> — protecting and
          stabilizing the elderly and vulnerable.
        </p>
        <p class="fine footer-links">
          <a href="/story">Our story</a> ·
          <a href="/welcome">Family guide</a> ·
          <a href="/terms">Terms</a> ·
          <a href="/privacy">Privacy</a> ·
          <a href="mailto:Mabel@AuntMabel.app">Mabel@AuntMabel.app</a>
        </p>
        <p class="fine">© 2026 · A call every day, and a knock on the door when it matters most.</p>
      </div>
    </footer>

    <script>
      // Resolve the header nav to signed-in or signed-out.
      //
      // The Supabase SDK is imported DYNAMICALLY, and only when localStorage
      // already looks like it holds a session. Public pages — home, /welcome,
      // /terms — are mostly read by people who have never signed in, and making
      // every one of them download the auth SDK to render one link is a real
      // cost on first paint. The localStorage check is only a cheap pre-filter;
      // the SDK remains the source of truth for whether the session is valid.
      (async () => {
        const nav = document.getElementById('site-nav');
        if (!nav) return; // bare pages have no nav

        /** @type {(state: 'in' | 'out') => void} */
        const resolve = (state) => nav.setAttribute('data-auth', state);

        let looksSignedIn = false;
        try {
          looksSignedIn = Object.keys(localStorage).some((k) => /^sb-.*-auth-token$/.test(k));
        } catch {
          // Storage blocked (private mode, strict settings). Treat as signed
          // out rather than failing — "Sign in" still works from there.
          resolve('out');
          return;
        }

        if (!looksSignedIn) {
          resolve('out');
          return;
        }

        try {
          const { getSupabase } = await import('../scripts/supabase.js');
          const { data } = await getSupabase().auth.getSession();
          resolve(data?.session ? 'in' : 'out');
        } catch (err) {
          // Missing config or a failed load must not leave the nav stuck in
          // "unknown" with nothing visible at all.
          console.error('[nav] could not resolve session state:', err);
          resolve('out');
        }
      })();
    </script>
  </body>
</html>
