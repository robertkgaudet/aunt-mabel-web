---
// Public shell for aunt-mabel-web — plain CSS, no Bootstrap, no jQuery.
// The Homer admin area under /homer/ uses src/layouts/homer/* instead; the
// two shells never appear on the same page.
//
// Header and footer reproduce the real auntmabel.app chrome (logo lockup +
// Ground Force tag; two-line footer). See docs/brand-capture.md.
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  /** Set true for auth pages and anything that should stay out of search. */
  noindex?: boolean;
  /** Drop the nav on focused pages (login, callback, signout). */
  bare?: boolean;
  /**
   * Social copy, when it should differ from the page title/description.
   *
   * A <title> earns its place in a search result and carries the product name;
   * a share card is read at a glance in a feed and wants the human sentence.
   * Optional — omit and the page title/description are used.
   */
  ogTitle?: string;
  ogDescription?: string;
  /** Per-page share image (site-relative). Defaults to the brand card. */
  ogImage?: string;
  /**
   * Drop the shared header AND footer, for a page that ships its own chrome
   * (the homepage). The <head> — meta, Open Graph, JSON-LD, fonts — still comes
   * from here, so there is exactly one place that defines it.
   */
  chrome?: boolean;
  /** Hide the header's partnership tag (the homepage hero already has one). */
  gfTag?: boolean;
}

const {
  title,
  description = 'A friendly call every day — and a knock on the door when disaster strikes.',
  noindex = false,
  bare = false,
  ogTitle,
  ogDescription,
  ogImage: ogImagePath,
  chrome = true,
  gfTag = true,
} = Astro.props;

const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;

// Absolute, because Facebook and X will not resolve a relative one.
const ogImage = new URL(ogImagePath ?? '/og-image.jpg', Astro.site).href;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#c25b50" />
    {/* The OPERATOR, per docs/AUNT-MABEL.md § Entity & naming. Cajun Navy
        Ground Force is the partner performing disaster checks; naming it as
        author here would imply the nonprofit runs the service. */}
    <meta name="author" content="Trustlight LLC" />

    {/* Service is US-wide; Louisiana is where it is operated from. Kept light
        on purpose — over-localising would suppress us outside the state. */}
    <meta name="geo.region" content="US-LA" />
    <meta name="geo.placename" content="Louisiana" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Brand faces — same single request as the live auntmabel.app page.
         Fraunces for headings/prose, Libre Franklin for body.
         See docs/brand-capture.md. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,900&family=Libre+Franklin:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:site_name" content="Aunt Mabel" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {/* The card is real now — built from scripts/og-image.html by
        scripts/build-og-image.mjs and committed as public/og-image.jpg. The
        note that used to sit here said there was deliberately no og:image
        because the file 404'd; shipping the tag without the file would have
        meant a knowingly-broken preview. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aunt Mabel — a friendly call every day, and someone there when it matters most." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    {chrome && <SiteHeader bare={bare} banner={!noindex} gfTag={gfTag} />}

    <main>
      <slot />
    </main>

    {chrome && <SiteFooter />}

    {/* The nav-resolving script moved into SiteHeader, so it travels with the markup it controls. */}
  </body>
</html>
