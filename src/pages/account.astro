---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Your account · Aunt Mabel" noindex={true}>
  <div class="wrap" id="content" hidden>
    <h1>Your account</h1>
    <p class="lede">
      Signed in as <strong id="user-email"></strong>.
    </p>

    <!-- Placeholder. Recipients, contacts, call history and billing land here
         once the signup flow is designed. -->

    <p style="margin-top:2rem">
      <a class="btn btn-secondary" href="/signout">Sign out</a>
    </p>
  </div>
</BaseLayout>

<script>
  // Reference implementation of the per-page guard. Copy these three lines
  // into any page that requires a signed-in user.
  import { requireSession } from '../scripts/auth.js';

  (async () => {
    const session = await requireSession();
    if (!session) return; // requireSession already redirected to /login

    document.getElementById('user-email').textContent = session.user.email ?? '';
    document.getElementById('content').hidden = false;
  })();
</script>
