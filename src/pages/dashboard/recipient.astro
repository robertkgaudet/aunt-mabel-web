---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
---

{/*
  Astro builds this site statically, so there is no /dashboard/recipient/[id]
  route to pre-render — the ids are UUIDs that only exist in Supabase. The id
  travels as a query parameter instead, and the page loads the row client-side
  under RLS, which is what actually enforces "only your own recipients".
*/}
<DashboardLayout title="Loved one · Aunt Mabel">
  <div class="dash-main">
    <a class="dash-back" href="/dashboard">← Everyone</a>

    <div class="dash-title-row">
      <h1 class="dash-h1" id="r-name">…</h1>
    </div>
    <p class="dash-lede" id="r-meta"></p>

    {/* Flagged calls surface here, above everything — a concern must never be
        something you have to scroll into a timeline to discover. */}
    <div id="alerts"></div>

    <section class="panel" id="days-panel">
      <div class="cal-head">
        <div>
          <h2 class="cal-month" id="cal-month">…</h2>
        </div>
        <div class="cal-nav">
          <span class="cal-summary" id="cal-summary"></span>
          <button class="cal-arrow" id="cal-prev" type="button" aria-label="Previous month">‹</button>
          <button class="cal-arrow" id="cal-next" type="button" aria-label="Next month">›</button>
        </div>
      </div>

      <div id="cal-wrap">
        <div class="cal-dow" aria-hidden="true">
          <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span>
          <span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="cal-grid" id="cal-grid"></div>

        <div class="cal-legend">
          <div><span class="cal-swatch good"></span>Good call</div>
          <div><span class="cal-swatch flag"></span>Flagged a concern</div>
          <div><span class="cal-swatch quiet"></span>No answer</div>
          <div><span class="cal-swatch pending"></span>Still writing up</div>
          <div><span class="cal-swatch none"></span>No call</div>
        </div>
      </div>
    </section>

    <section class="panel" id="timeline-panel">
      <h2>Recent calls</h2>
      <p class="panel-sub">A short note from Mabel after every check-in.</p>
      <div id="timeline"></div>
    </section>

    <section class="panel">
      <h2 id="manage-title">Manage these calls</h2>
      <p class="panel-sub">Change anything here and Mabel will know before the next call.</p>

      <div class="manage-grid" id="manage-grid"></div>
      <div id="edit-region" hidden></div>

      <div class="dash-actions">
        <a class="dash-btn dark" href="/enroll">+ Add another loved one</a>
        <button class="dash-btn ghost" id="manage-billing" type="button">Pause or cancel</button>
      </div>
      <p class="dash-note" id="manage-note" hidden></p>
      <p class="hint" style="margin-top:12px">
        Pausing and cancelling both run through Stripe, where your billing lives.
      </p>
    </section>

    <section class="panel">
      <h2>What Mabel asks about</h2>
      <p class="panel-sub">The same warm check-in every day. These aren’t adjustable yet.</p>
      <div class="manage-grid">
        <div class="manage-tile" aria-disabled="true">
          <div class="manage-label">Every call</div>
          <div class="manage-value">How they slept, whether they’ve eaten, and how they’re feeling</div>
        </div>
        <div class="manage-tile" aria-disabled="true">
          <div class="manage-label">Watching for</div>
          <div class="manage-value">Falls, pain, confusion, missed medication, low mood</div>
        </div>
        <div class="manage-tile" aria-disabled="true">
          <div class="manage-label">And simply</div>
          <div class="manage-value">A friendly conversation, for as long as they’d like one</div>
        </div>
      </div>
    </section>
  </div>
</DashboardLayout>

<script>
  import {
    initDashboard,
    engineFetch,
    friendlyTime,
    friendlyZone,
  } from '../../scripts/dashboard.js';

  const note = (el, message, kind) => {
    el.textContent = message;
    el.className = `dash-note ${kind || ''}`.trim();
    el.hidden = false;
  };
  const esc = (s) => String(s ?? '');

  const MONTHS = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];

  /**
   * Split a Postgres DATE ('2026-08-20') into parts by hand.
   *
   * ⚠️ NOT `new Date('2026-08-20')` — that parses as UTC midnight, so anyone
   * west of Greenwich renders it as the 19th. A call log that shows every call
   * on the wrong day would be quietly, confidently wrong, which is worse than
   * visibly broken. call_date is already the LOCAL date in the recipient's
   * timezone (see migration 0007), so it needs no conversion at all.
   */
  function parseYMD(s) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s || ''));
    if (!m) return null;
    return { y: Number(m[1]), mo: Number(m[2]) - 1, d: Number(m[3]) };
  }

  /** Today, as seen in the recipient's own timezone — their day, not ours. */
  function todayThere(timezone) {
    try {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: timezone || 'America/Chicago',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date());
      return parseYMD(parts);
    } catch {
      const now = new Date();
      return { y: now.getFullYear(), mo: now.getMonth(), d: now.getDate() };
    }
  }

  /**
   * One day can hold several call rows — the scheduler retries, and `attempt`
   * counts them. So a day is summarised, not read off a single row:
   *
   *   escalated  → flag   (a concern shows even if a later attempt went fine)
   *   completed  → good   (missed at 9, reached at 9:20, is a good day)
   *   no_answer  → quiet
   *   placed     → pending (still being written up; NOT a failure)
   */
  function dayOutcome(calls) {
    if (!calls || !calls.length) return null;
    if (calls.some((c) => c.escalate)) return 'flag';
    if (calls.some((c) => c.status === 'completed')) return 'good';
    if (calls.some((c) => c.status === 'no_answer' || c.status === 'failed')) return 'quiet';
    if (calls.some((c) => c.status === 'placed')) return 'pending';
    return null;
  }

  function durationLabel(seconds) {
    if (seconds == null) return '';
    if (seconds < 60) return `${seconds} sec`;
    return `${Math.round(seconds / 60)} min`;
  }

  /**
   * Topic labels for one call, from analysis -> custom_analysis_data ->
   * topics_discussed. Returns [] for every shape that isn't usable, because
   * absent is the normal case: the field was only added to the Retell agent
   * recently, so nearly every historical row lacks it entirely.
   *
   * Supabase hands back JSONB already parsed, so analysis is an object here.
   * The field itself is a comma-separated string; an array is accepted too,
   * so a change to how the Retell field is configured cannot empty this out.
   */
  function callTopics(analysis) {
    try {
      const raw = analysis?.custom_analysis_data?.topics_discussed;
      if (raw == null) return [];
      const list = Array.isArray(raw) ? raw : String(raw).split(',');
      return list.map((t) => String(t).trim()).filter(Boolean);
    } catch {
      return [];
    }
  }

  /** Clock time of the call, shown in the recipient's timezone. */
  function callClock(iso, timezone) {
    if (!iso) return '';
    try {
      return new Intl.DateTimeFormat(undefined, {
        timeZone: timezone || 'America/Chicago',
        hour: 'numeric',
        minute: '2-digit',
      }).format(new Date(iso));
    } catch {
      return '';
    }
  }

  (async () => {
    const ctx = await initDashboard();
    if (!ctx) return;
    const { supabase, session, account } = ctx;

    document.getElementById('dash-content').hidden = false;

    const id = new URLSearchParams(window.location.search).get('id') || '';
    const fatal = (msg) => {
      document.getElementById('r-name').textContent = 'Not found';
      document.getElementById('r-meta').textContent = msg;
      document.querySelectorAll('.panel').forEach((p) => (p.hidden = true));
    };

    if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id)) {
      fatal('That link doesn’t point to anyone on your account.');
      return;
    }

    const { data: r, error } = await supabase
      .from('recipients')
      .select(
        'id, name, phone, timezone, call_time, status, verbal_consent, doctor_name, doctor_phone, zip'
      )
      .eq('id', id)
      .eq('account_id', account.id)
      .maybeSingle();

    if (error) {
      console.error('[recipient] load failed', error);
      fatal('We couldn’t load this person just now. Please refresh in a moment.');
      return;
    }
    if (!r) {
      fatal('That link doesn’t point to anyone on your account.');
      return;
    }

    const { data: contacts } = await supabase
      .from('contacts')
      .select('id, name, email, phone, relationship, notify_method')
      .eq('recipient_id', r.id)
      .order('created_at', { ascending: true });

    // ------------------------------------------------------------- header
    const firstName = (r.name || '').split(/\s+/)[0] || 'them';
    document.getElementById('r-name').textContent = r.name || 'Unnamed';
    document.getElementById('manage-title').textContent = `Manage ${firstName}’s calls`;

    const time = friendlyTime(r.call_time);
    const zone = friendlyZone(r.timezone);
    const statusWord =
      r.status === 'active'
        ? r.verbal_consent
          ? 'Calling daily'
          : 'First call coming up'
        : r.status === 'paused'
          ? 'Paused'
          : 'Sign-up not finished';
    document.getElementById('r-meta').textContent =
      `${statusWord} · ${time ? `calls at ${time}` : 'call time not set'}${zone ? ` · ${zone}` : ''}`;

    // -------------------------------------------------------------- calls
    // One fetch, rendered many ways. At pilot scale this is tens of rows; the
    // cap exists so a year of history can't turn into an unbounded payload,
    // and the timeline says plainly when it has been reached.
    const CALL_CAP = 400;
    const { data: calls, error: callsErr } = await supabase
      .from('calls')
      .select(
        'id, call_date, attempt, status, duration_seconds, summary, sentiment, escalate, escalate_reason, consent_confirmed, created_at, ended_at, analysis'
      )
      .eq('recipient_id', r.id)
      .order('call_date', { ascending: false })
      .order('created_at', { ascending: false })
      .limit(CALL_CAP);

    const daysPanel = document.getElementById('days-panel');
    const timelinePanel = document.getElementById('timeline-panel');
    const alerts = document.getElementById('alerts');

    if (callsErr) {
      console.error('[recipient] calls load failed', callsErr);
      daysPanel.innerHTML =
        '<h2>Her days</h2><p class="panel-sub">We couldn’t load the call history just now. Please refresh in a moment.</p>';
      daysPanel.querySelector('h2').textContent = `${firstName}’s days`;
      timelinePanel.hidden = true;
    } else if (!calls || calls.length === 0) {
      // ---------------------------------------------------- no calls yet
      // Deliberately NOT an empty calendar. Thirty blank squares next to a
      // legend that explains what grey means reads as thirty missed calls.
      const when = time ? `at ${time}${zone ? ` ${zone.toLowerCase()}` : ''}` : 'soon';
      daysPanel.innerHTML = `
        <div class="first-call">
          <div class="glyph" aria-hidden="true">📞</div>
          <h3></h3>
          <p></p>
        </div>
      `;
      daysPanel.querySelector('h3').textContent =
        r.status === 'active' ? 'Mabel’s first call is coming up' : 'No calls yet';
      daysPanel.querySelector('p').textContent =
        r.status === 'active'
          ? `She calls ${when}. Once she’s spoken to ${firstName}, this is where every call will appear — a month at a glance, and a note from each one.`
          : `Once ${firstName}’s calls begin, this is where they’ll appear.`;
      timelinePanel.hidden = true;
    } else {
      renderCalls(calls);
    }

    function renderCalls(rows) {
      // Bucket by local call date once; both the calendar and the "worst day"
      // lookups read from this rather than re-scanning.
      const byDate = new Map();
      for (const c of rows) {
        if (!byDate.has(c.call_date)) byDate.set(c.call_date, []);
        byDate.get(c.call_date).push(c);
      }

      // ------------------------------------------------------- alerts
      const flagged = rows.filter((c) => c.escalate);
      // Most recent three. Older concerns stay visible in the timeline; the
      // point here is what needs attention now, not a complete record.
      for (const c of flagged.slice(0, 3)) {
        const p = parseYMD(c.call_date);
        const when = p ? `${MONTHS[p.mo]} ${p.d}` : '';
        const card = document.createElement('div');
        card.className = 'alert-card';
        card.innerHTML = `
          <div class="alert-eyebrow">Worth a look</div>
          <div class="alert-title"></div>
          <p class="alert-body"></p>
          <div class="dash-actions" style="margin-top:0"></div>
        `;
        card.querySelector('.alert-title').textContent =
          `Mabel flagged a concern on ${when}.`;
        card.querySelector('.alert-body').textContent =
          c.escalate_reason || c.summary || 'Mabel flagged this call for a follow-up.';

        // A real phone link, because it is the only action on this card we can
        // actually carry out. The mockup also offered "listen to the call" and
        // "mark as handled" — we don't record calls, and `calls` has no write
        // policy under RLS by design, so neither button could do anything.
        const actions = card.querySelector('.dash-actions');
        if (r.phone) {
          const tel = document.createElement('a');
          tel.className = 'dash-btn';
          tel.href = `tel:${r.phone.replace(/[^\d+]/g, '')}`;
          tel.textContent = `Call ${firstName}`;
          actions.appendChild(tel);
        }
        alerts.appendChild(card);
      }

      // ----------------------------------------------------- calendar
      const earliest = parseYMD(rows[rows.length - 1].call_date);
      const today = todayThere(r.timezone);
      let view = { y: today.y, mo: today.mo };

      const grid = document.getElementById('cal-grid');
      const label = document.getElementById('cal-month');
      const summary = document.getElementById('cal-summary');
      const prev = document.getElementById('cal-prev');
      const next = document.getElementById('cal-next');

      function paintMonth() {
        const { y, mo } = view;
        label.textContent = `${MONTHS[mo]} ${y}`;

        const firstDow = new Date(y, mo, 1).getDay();
        const daysInMonth = new Date(y, mo + 1, 0).getDate();

        grid.innerHTML = '';
        for (let i = 0; i < firstDow; i++) {
          const pad = document.createElement('div');
          pad.className = 'cal-cell pad';
          grid.appendChild(pad);
        }

        const tally = { good: 0, flag: 0, quiet: 0, pending: 0 };
        for (let d = 1; d <= daysInMonth; d++) {
          const key = `${y}-${String(mo + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
          const dayCalls = byDate.get(key);
          const outcome = dayOutcome(dayCalls);
          if (outcome) tally[outcome] = (tally[outcome] || 0) + 1;

          const isToday = y === today.y && mo === today.mo && d === today.d;
          const isFuture =
            y > today.y || (y === today.y && (mo > today.mo || (mo === today.mo && d > today.d)));

          const cell = document.createElement('div');
          cell.className = `cal-cell ${outcome || (isFuture ? 'future' : 'none')}${isToday ? ' today' : ''}`;
          cell.textContent = String(d);
          if (outcome) {
            const names = {
              good: 'Good call',
              flag: 'Flagged a concern',
              quiet: 'No answer',
              pending: 'Still being written up',
            };
            cell.title = `${MONTHS[mo]} ${d} — ${names[outcome]}`;
          }
          grid.appendChild(cell);
        }

        const bits = [];
        if (tally.good) bits.push(`${tally.good} good ${tally.good === 1 ? 'call' : 'calls'}`);
        if (tally.flag) bits.push(`${tally.flag} flagged`);
        if (tally.quiet) bits.push(`${tally.quiet} no answer`);
        if (tally.pending) bits.push(`${tally.pending} pending`);
        summary.textContent = bits.length ? bits.join(' · ') : 'No calls this month';

        // Paging stops where the data does in one direction and at the present
        // in the other — there is nothing to show beyond either edge.
        const atEarliest =
          !earliest || (y < earliest.y || (y === earliest.y && mo <= earliest.mo));
        const atLatest = y > today.y || (y === today.y && mo >= today.mo);
        prev.disabled = atEarliest;
        next.disabled = atLatest;
      }

      prev.addEventListener('click', () => {
        view = view.mo === 0 ? { y: view.y - 1, mo: 11 } : { y: view.y, mo: view.mo - 1 };
        paintMonth();
      });
      next.addEventListener('click', () => {
        view = view.mo === 11 ? { y: view.y + 1, mo: 0 } : { y: view.y, mo: view.mo + 1 };
        paintMonth();
      });
      paintMonth();

      // ----------------------------------------------------- timeline
      const timeline = document.getElementById('timeline');
      const PAGE = 8;
      let shown = PAGE;

      function paintTimeline() {
        timeline.innerHTML = '';
        for (const c of rows.slice(0, shown)) {
          const p = parseYMD(c.call_date);
          const dateLabel = p
            ? new Date(p.y, p.mo, p.d).toLocaleDateString(undefined, {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
              })
            : c.call_date;

          const pending = c.status === 'placed' && !c.summary;
          const noAnswer = c.status === 'no_answer' || c.status === 'failed';

          const row = document.createElement('div');
          row.className = `call-row${c.escalate ? ' flagged' : ''}`;
          row.innerHTML = `
            <div class="call-when">
              <div class="call-date"></div>
              <div class="call-time"></div>
              <div class="call-dur"></div>
            </div>
            <div class="call-body">
              <div class="call-sentiment"><span class="call-dot"></span><span class="sent-text"></span></div>
              <p class="call-summary"></p>
            </div>
          `;

          row.querySelector('.call-date').textContent = dateLabel;
          row.querySelector('.call-time').textContent = callClock(c.created_at, r.timezone);
          row.querySelector('.call-dur').textContent = noAnswer
            ? '—'
            : durationLabel(c.duration_seconds);

          const dot = row.querySelector('.call-dot');
          const sent = row.querySelector('.sent-text');
          const body = row.querySelector('.call-summary');

          if (c.escalate) {
            dot.className = 'call-dot flag';
            sent.textContent = c.sentiment || 'Flagged';
          } else if (pending) {
            dot.className = 'call-dot pending';
            sent.textContent = 'Just finished';
          } else if (noAnswer) {
            dot.className = 'call-dot quiet';
            sent.textContent = c.status === 'failed' ? 'Couldn’t connect' : 'No answer';
          } else {
            dot.className = 'call-dot';
            sent.textContent = c.sentiment || 'Called';
          }

          if (c.summary) {
            body.textContent = c.summary;
          } else if (pending) {
            // Placed, but the analysis webhook hasn't landed. This is a normal
            // in-between state for a few minutes after a call, and saying so is
            // the difference between "still going" and "something went wrong".
            body.className = 'call-summary muted';
            body.textContent = 'Mabel is still writing up this call.';
          } else if (noAnswer) {
            body.className = 'call-summary muted';
            body.textContent =
              c.status === 'failed'
                ? 'The call couldn’t be connected.'
                : `Mabel called but couldn’t reach ${firstName}.`;
          } else {
            body.className = 'call-summary muted';
            body.textContent = 'No note was recorded for this call.';
          }

          if (c.escalate && c.escalate_reason) {
            const why = document.createElement('div');
            why.className = 'call-reason';
            why.textContent = c.escalate_reason;
            row.querySelector('.call-body').appendChild(why);
          }

          // Topics are the index, not the story — so they sit last, after any
          // concern, and render nothing at all when absent. Retell only began
          // returning topics_discussed recently, so the overwhelming majority
          // of rows have no analysis, no custom_analysis_data, or no field.
          // An empty tag strip on every historical call would be worse than
          // silence, so there is deliberately no label and no placeholder.
          const topics = callTopics(c.analysis);
          if (topics.length) {
            const strip = document.createElement('div');
            strip.className = 'call-topics';
            for (const t of topics) {
              const tag = document.createElement('span');
              // textContent, never innerHTML: these labels come back from the
              // model, and this row is rendered straight into the page.
              tag.textContent = t;
              strip.appendChild(tag);
            }
            row.querySelector('.call-body').appendChild(strip);
          }

          timeline.appendChild(row);
        }

        if (rows.length > shown) {
          const more = document.createElement('button');
          more.type = 'button';
          more.className = 'call-more';
          more.textContent = `Show ${Math.min(PAGE, rows.length - shown)} more of ${rows.length} calls →`;
          more.addEventListener('click', () => {
            shown += PAGE;
            paintTimeline();
          });
          timeline.appendChild(more);
        } else if (rows.length >= CALL_CAP) {
          const capped = document.createElement('p');
          capped.className = 'hint';
          capped.style.marginTop = '16px';
          capped.textContent = `Showing the most recent ${CALL_CAP} calls.`;
          timeline.appendChild(capped);
        }
      }
      paintTimeline();
    }

    // ------------------------------------------------------------- manage
    const grid = document.getElementById('manage-grid');
    const region = document.getElementById('edit-region');
    const manageNote = document.getElementById('manage-note');

    const contactSummary = () => {
      if (!contacts || contacts.length === 0) return 'Nobody added yet';
      return contacts.map((c) => c.name).filter(Boolean).join(', ') || 'Nobody added yet';
    };
    const doctorSummary = () =>
      r.doctor_name ? `${r.doctor_name}${r.doctor_phone ? ` · ${r.doctor_phone}` : ''}` : 'Not added';

    const tiles = [
      {
        key: 'time',
        label: 'Call time',
        value: () =>
          friendlyTime(r.call_time)
            ? `Every day at ${friendlyTime(r.call_time)}${zone ? ` (${zone})` : ''}`
            : 'Not set',
      },
      { key: 'contacts', label: 'Who we alert', value: contactSummary },
      { key: 'doctor', label: 'Their doctor', value: doctorSummary },
    ];

    function paintTiles() {
      grid.innerHTML = '';
      for (const t of tiles) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'manage-tile';
        b.innerHTML = '<div class="manage-label"></div><div class="manage-value"></div>';
        b.querySelector('.manage-label').textContent = t.label;
        b.querySelector('.manage-value').textContent = t.value();
        b.addEventListener('click', () => openEditor(t.key));
        grid.appendChild(b);
      }
    }

    function closeEditor() {
      region.hidden = true;
      region.innerHTML = '';
    }

    async function save(patch) {
      manageNote.hidden = true;
      const { data, error: saveErr } = await supabase
        .from('recipients')
        .update(patch)
        .eq('id', r.id)
        .select('id, call_time, doctor_name, doctor_phone')
        .single();

      if (saveErr) {
        console.error('[recipient] save failed', saveErr);
        note(manageNote, 'We couldn’t save that just now. Please try again.', 'error');
        return false;
      }
      Object.assign(r, data);
      paintTiles();
      closeEditor();
      note(manageNote, 'Saved.', 'ok');
      return true;
    }

    function openEditor(key) {
      region.hidden = false;

      if (key === 'time') {
        region.innerHTML = `
          <div class="panel" style="margin:18px 0 0;background:var(--cream)">
            <div class="field">
              <label for="edit-time">What time should Mabel call?</label>
              <input id="edit-time" type="time" value="${esc(r.call_time)}" />
              <p class="hint">In ${esc(zone || r.timezone)} — ${esc(firstName)}’s own clock.</p>
            </div>
            <div class="dash-actions">
              <button class="dash-btn" id="edit-save" type="button">Save</button>
              <button class="dash-btn ghost" id="edit-cancel" type="button">Cancel</button>
            </div>
          </div>
        `;
        region.querySelector('#edit-save').addEventListener('click', () => {
          const v = region.querySelector('#edit-time').value;
          if (!/^\d{2}:\d{2}$/.test(v)) {
            note(manageNote, 'Please pick a time.', 'error');
            return;
          }
          save({ call_time: v });
        });
      }

      if (key === 'doctor') {
        region.innerHTML = `
          <div class="panel" style="margin:18px 0 0;background:var(--cream)">
            <div class="field">
              <label for="edit-doc-name">Doctor’s name</label>
              <input id="edit-doc-name" type="text" value="${esc(r.doctor_name)}" placeholder="Optional" />
            </div>
            <div class="field">
              <label for="edit-doc-phone">Doctor’s phone</label>
              <input id="edit-doc-phone" type="tel" value="${esc(r.doctor_phone)}" placeholder="Optional" />
            </div>
            <div class="dash-actions">
              <button class="dash-btn" id="edit-save" type="button">Save</button>
              <button class="dash-btn ghost" id="edit-cancel" type="button">Cancel</button>
            </div>
          </div>
        `;
        region.querySelector('#edit-save').addEventListener('click', () => {
          const name = region.querySelector('#edit-doc-name').value.trim();
          const phone = region.querySelector('#edit-doc-phone').value.trim();
          if (phone && !name) {
            note(manageNote, 'Please add the doctor’s name too.', 'error');
            return;
          }
          save({ doctor_name: name || null, doctor_phone: phone || null });
        });
      }

      if (key === 'contacts') {
        const rowsHtml = (contacts || [])
          .map(
            (c, i) => `
            <div class="field">
              <label for="c-name-${i}">Contact ${i + 1} — name</label>
              <input id="c-name-${i}" type="text" value="${esc(c.name)}" />
            </div>
            <div class="field">
              <label for="c-email-${i}">Contact ${i + 1} — email</label>
              <input id="c-email-${i}" type="email" value="${esc(c.email)}" />
            </div>`
          )
          .join('');

        region.innerHTML = `
          <div class="panel" style="margin:18px 0 0;background:var(--cream)">
            ${rowsHtml || '<p class="sub-body">Nobody is set up to be alerted yet.</p>'}
            <p class="hint">
              Alerts go by email. Adding or removing people is part of the sign-up flow for now.
            </p>
            <div class="dash-actions">
              ${contacts && contacts.length ? '<button class="dash-btn" id="edit-save" type="button">Save</button>' : ''}
              <button class="dash-btn ghost" id="edit-cancel" type="button">Close</button>
            </div>
          </div>
        `;

        const saveBtn = region.querySelector('#edit-save');
        if (saveBtn) {
          saveBtn.addEventListener('click', async () => {
            manageNote.hidden = true;
            for (let i = 0; i < contacts.length; i++) {
              const name = region.querySelector(`#c-name-${i}`).value.trim();
              const email = region.querySelector(`#c-email-${i}`).value.trim();
              if (!name || !email) {
                note(manageNote, 'Each contact needs a name and an email.', 'error');
                return;
              }
              const { error: cErr } = await supabase
                .from('contacts')
                .update({ name, email })
                .eq('id', contacts[i].id);
              if (cErr) {
                console.error('[recipient] contact save failed', cErr);
                note(manageNote, 'We couldn’t save that just now. Please try again.', 'error');
                return;
              }
              contacts[i].name = name;
              contacts[i].email = email;
            }
            paintTiles();
            closeEditor();
            note(manageNote, 'Saved.', 'ok');
          });
        }
      }

      const cancelBtn = region.querySelector('#edit-cancel');
      if (cancelBtn) cancelBtn.addEventListener('click', closeEditor);
    }

    paintTiles();

    // ------------------------------------------------------------ billing
    const billingBtn = document.getElementById('manage-billing');
    billingBtn.addEventListener('click', async () => {
      billingBtn.disabled = true;
      manageNote.hidden = true;
      try {
        const { url } = await engineFetch('/api/create-portal-session', {}, session);
        window.location.href = url;
      } catch (err) {
        console.error('[recipient] portal failed', err);
        note(manageNote, err.message || 'We couldn’t open billing just now.', 'error');
        billingBtn.disabled = false;
      }
    });
  })();
</script>
