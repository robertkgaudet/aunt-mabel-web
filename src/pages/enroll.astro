---
// Enrollment flow — Chunk 1: skeleton + Step 1.
//
// ARCHITECTURE "C" (hybrid), deliberate:
//   - Steps marked kind:'collect' are DATA COLLECTION. They live on this one
//     page and swap client-side, so answering eight short questions never costs
//     eight page loads.
//   - Steps marked kind:'handoff' are NOT views on this page. Account creation
//     and Stripe are real navigation boundaries — a redirect out and back.
//     They are declared here only so the progress indicator can count them
//     honestly. Do NOT turn them into JS views: account creation has to survive
//     an email round-trip, and Stripe owns its own page.
//
// The step list below is the single source of truth for both the flow order and
// the "Step N of M" denominator. Add a step here, and the indicator follows.
//
// SCOPE OF THIS CHUNK: step 1 is real. Step 2 is a visible placeholder that
// exists only to prove the advance mechanism works. Steps 3-8 are declared but
// have no content yet. Their titles are inferred from the v2 schema
// (recipients/contacts + the consent timestamps), NOT from a settled design doc
// — confirm before building them out.
import BaseLayout from '../layouts/BaseLayout.astro';

const STEPS = [
  { id: 'who-for',    kind: 'collect', title: 'Who is this for?' },
  { id: 'recipient',  kind: 'collect', title: 'Who are we calling?' },
  { id: 'schedule',   kind: 'collect', title: 'When should Mabel call?' },
  { id: 'location',   kind: 'collect', title: 'Where do they live?' },
  { id: 'contacts',   kind: 'collect', title: 'Who should we tell?' },
  { id: 'consent',    kind: 'collect', title: 'Consent' },
  { id: 'account',    kind: 'handoff', title: 'Create your account' },
  { id: 'payment',    kind: 'handoff', title: 'Payment' },
];
const TOTAL = STEPS.length;
---

<BaseLayout
  title="Set up a daily call · Aunt Mabel"
  description="Set up Aunt Mabel's daily check-in call."
  noindex={true}
  bare={true}
>
  <div class="wrap enroll" data-total={TOTAL}>
    {/* ── progress ─────────────────────────────────────────────────── */}
    <div class="progress" role="group" aria-label="Enrollment progress">
      <div class="progress-track">
        <div class="progress-fill" id="progress-fill"></div>
      </div>
      <p class="progress-text" id="progress-text" aria-live="polite">Step 1 of {TOTAL}</p>
    </div>

    {/* ── Step 1 — real ────────────────────────────────────────────── */}
    <section class="step" data-step="0" id="step-who-for">
      <h1>Who are we calling each day?</h1>
      <p class="step-lede">
        Mabel's call is the same either way — we just want to know whose door
        we'd be knocking on.
      </p>

      <fieldset class="choices">
        <legend class="sr-only">Who is this for?</legend>

        <label class="choice">
          <input type="radio" name="who-for" value="loved-one" />
          <span class="choice-body">
            <span class="choice-title">My parent or loved one</span>
            <span class="choice-note">You'll set up their calls, and we'll keep you posted on how they're doing.</span>
          </span>
          <span class="choice-check" aria-hidden="true"></span>
        </label>

        <label class="choice">
          <input type="radio" name="who-for" value="myself" />
          <span class="choice-body">
            <span class="choice-title">Myself</span>
            <span class="choice-note">Mabel will call you, and you choose who else hears how you're getting on.</span>
          </span>
          <span class="choice-check" aria-hidden="true"></span>
        </label>
      </fieldset>

      <div class="step-actions">
        <button type="button" class="btn btn-primary" id="continue-1" disabled>Continue</button>
        <a class="btn-quiet" href="/">Not just now</a>
      </div>
    </section>

    {/* ── Step 2 — placeholder only. Real content is the next chunk. ── */}
    <section class="step" data-step="1" id="step-recipient" hidden>
      <h1>Step 2 coming next</h1>
      <p class="step-lede">
        This screen is a placeholder. It exists so the step-advance can be
        verified end to end — its real content lands in the next chunk.
      </p>
      <div class="step-actions">
        <button type="button" class="btn btn-secondary" id="back-2">Back</button>
      </div>
    </section>

    {/* TEMPORARY — remove before launch. Lets Rob see captured state without
        opening devtools. Tracked as a cleanup item for the final chunk. */}
    <aside class="debug" id="debug">
      <strong>debug (temporary)</strong>
      <code id="debug-state">{'{}'}</code>
    </aside>
  </div>
</BaseLayout>

<script>
  // ── flow state ────────────────────────────────────────────────────────
  // In-memory only, by design for this chunk.
  //
  // LIMITATION (accepted, noted): a full page reload clears this. Rather than
  // restore a later step with empty answers — which would silently show someone
  // a screen whose earlier data is gone — a reload deliberately returns to
  // step 1. Persisting across reloads (sessionStorage) is a later decision,
  // and it interacts with what we're allowed to keep before consent, so it is
  // NOT something to add casually.
  const state = {
    is_self: null,
  };

  const stepEls = Array.from(document.querySelectorAll('.step'));
  const total = Number(document.querySelector('.enroll').dataset.total);
  const fill = document.getElementById('progress-fill');
  const text = document.getElementById('progress-text');
  const debugEl = document.getElementById('debug-state');

  let current = 0;

  function renderDebug() {
    debugEl.textContent = JSON.stringify(state);
    console.log('[enroll] state', { ...state, step: current + 1 });
  }

  function show(index, { push = true } = {}) {
    if (index < 0 || index >= stepEls.length) return;
    current = index;

    stepEls.forEach((el, i) => { el.hidden = i !== index; });

    const pct = ((index + 1) / total) * 100;
    fill.style.width = pct + '%';
    text.textContent = `Step ${index + 1} of ${total}`;

    // Move focus to the new heading so keyboard and screen-reader users are
    // taken to the new question rather than left where the old button was.
    const heading = stepEls[index].querySelector('h1');
    if (heading) {
      heading.setAttribute('tabindex', '-1');
      heading.focus({ preventScroll: true });
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });

    if (push) history.pushState({ step: index }, '', location.pathname);
    renderDebug();
  }

  // ── step 1 ────────────────────────────────────────────────────────────
  const continueBtn = document.getElementById('continue-1');

  document.querySelectorAll('input[name="who-for"]').forEach((input) => {
    input.addEventListener('change', () => {
      // Explicit Continue rather than auto-advance: this audience benefits from
      // a beat to change their mind, and a screen that jumps out from under a
      // tap reads as an error, not as speed.
      state.is_self = input.value === 'myself';
      continueBtn.disabled = false;
      renderDebug();
    });
  });

  continueBtn.addEventListener('click', () => {
    if (state.is_self === null) return; // no silent advance on missing data
    show(1);
  });

  document.getElementById('back-2').addEventListener('click', () => show(0));

  // ── within-flow back/forward ──────────────────────────────────────────
  // Browser Back moves between steps instead of dumping people out of the flow.
  window.addEventListener('popstate', (e) => {
    const target = e.state && typeof e.state.step === 'number' ? e.state.step : 0;
    // Never restore past a step whose prerequisite answer is missing.
    show(state.is_self === null ? 0 : target, { push: false });
  });

  history.replaceState({ step: 0 }, '', location.pathname);
  show(0, { push: false });
</script>

<style>
  .enroll { max-width: 44rem; padding-top: 2.5rem; }

  /* ── progress — gentle, not clinical ──────────────────────────────── */
  .progress { margin-bottom: 2.75rem; }
  .progress-track {
    height: 4px;
    background: var(--line);
    border-radius: 999px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    width: 12.5%;
    background: var(--gold);
    border-radius: 999px;
    transition: width 0.4s ease;
  }
  .progress-text {
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft-ink);
    font-weight: 500;
  }

  /* ── step ─────────────────────────────────────────────────────────── */
  .step h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 600; margin-bottom: 0.6rem; }
  .step h1:focus { outline: none; }
  .step-lede {
    font-size: 1.08rem;
    color: var(--soft-ink);
    max-width: 40ch;
    margin: 0 0 2.25rem;
  }

  /* ── choice cards ─────────────────────────────────────────────────── */
  .choices { border: 0; padding: 0; margin: 0 0 2.25rem; display: grid; gap: 14px; }

  .choice {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 26px 60px 26px 28px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
    cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .choice:hover { border-color: var(--rose); transform: translateY(-1px); }

  /* The real radio stays in the DOM for keyboard and screen readers; it is
     visually replaced by .choice-check. */
  .choice input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .choice:focus-within {
    outline: 3px solid var(--rose);
    outline-offset: 2px;
  }
  .choice:has(input:checked) {
    border-color: var(--rose);
    box-shadow: 0 0 0 1px var(--rose), 0 18px 36px -24px rgba(45, 36, 23, 0.4);
    background: #fffdf8;
  }

  .choice-body { display: block; }
  .choice-title {
    display: block;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--ink);
    line-height: 1.2;
  }
  .choice-note {
    display: block;
    margin-top: 6px;
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--soft-ink);
    max-width: 42ch;
  }

  .choice-check {
    position: absolute;
    right: 26px;
    top: 50%;
    transform: translateY(-50%);
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--line);
    background: var(--cream);
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .choice:has(input:checked) .choice-check {
    border-color: var(--rose);
    background: var(--rose);
    box-shadow: inset 0 0 0 4px var(--paper);
  }

  /* ── actions ──────────────────────────────────────────────────────── */
  .step-actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .btn-quiet {
    font-size: 0.95rem;
    color: var(--soft-ink);
    text-decoration: none;
  }
  .btn-quiet:hover { color: var(--rose-deep); text-decoration: underline; }

  /* ── temporary debug strip — remove before launch ─────────────────── */
  .debug {
    margin-top: 3.5rem;
    padding: 10px 14px;
    border: 1px dashed var(--line);
    border-radius: 10px;
    background: var(--paper);
    font-size: 0.75rem;
    color: var(--soft-ink);
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .debug code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--ink); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 820px) {
    .choice { padding: 22px 56px 22px 22px; }
    .choice-title { font-size: 1.18rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .progress-fill, .choice { transition: none; }
    .choice:hover { transform: none; }
  }
</style>
