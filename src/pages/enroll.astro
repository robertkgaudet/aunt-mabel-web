---
// Enrollment flow — Chunk 2: step array realigned to spec + Step 2 (account).
//
// SPEC: docs/enrollment-flow-design.md is the source of truth for order and
// decisions. The array below matches it. If they ever disagree, the doc wins
// and this array is the thing that's wrong.
//
// ARCHITECTURE "C" (hybrid):
//   - kind:'collect' steps swap client-side on this page.
//   - kind:'handoff' steps are REAL navigation boundaries. Step 2 leaves for
//     Google or for an email round-trip; Step 7 leaves for Stripe Checkout.
//     Do not turn either into an in-page view — the flow depends on them
//     surviving a full trip out of the browser tab and back.
//
// SCOPE OF THIS CHUNK: steps 1 and 2 are real. Step 3 is a visible placeholder
// proving the post-auth return lands inside the flow. Steps 4-8 are declared
// for the progress denominator only.
import BaseLayout from '../layouts/BaseLayout.astro';

const STEPS = [
  { id: 'who-for',   kind: 'collect',      title: 'Who is this for?' },
  { id: 'account',   kind: 'handoff',      title: 'Create your account' },
  { id: 'recipient', kind: 'collect',      title: "Who we're calling" },
  { id: 'contacts',  kind: 'collect',      title: 'Emergency contacts' },
  { id: 'doctor',    kind: 'collect',      title: 'Doctor (optional)' },
  { id: 'consent',   kind: 'collect',      title: 'Consent' },
  { id: 'payment',   kind: 'handoff',      title: 'Payment' },
  { id: 'done',      kind: 'confirmation', title: 'Done' },
];
const TOTAL = STEPS.length;
---

<BaseLayout
  title="Set up a daily call · Aunt Mabel"
  description="Set up Aunt Mabel's daily check-in call."
  noindex={true}
  bare={true}
>
  <div class="wrap enroll" data-total={TOTAL}>
    <div class="progress" role="group" aria-label="Enrollment progress">
      <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
      <p class="progress-text" id="progress-text" aria-live="polite">Step 1 of {TOTAL}</p>
    </div>

    {/* ── Step 1 — Who is this for? ─────────────────────────────────── */}
    <section class="step" data-step="0" id="step-who-for">
      <h1>Who are we calling each day?</h1>
      <p class="step-lede">
        Mabel's call is the same either way — we just want to know whose door
        we'd be knocking on.
      </p>

      <fieldset class="choices">
        <legend class="sr-only">Who is this for?</legend>
        <label class="choice">
          <input type="radio" name="who-for" value="loved-one" />
          <span class="choice-body">
            <span class="choice-title">My parent or loved one</span>
            <span class="choice-note">You'll set up their calls, and we'll keep you posted on how they're doing.</span>
          </span>
          <span class="choice-check" aria-hidden="true"></span>
        </label>
        <label class="choice">
          <input type="radio" name="who-for" value="myself" />
          <span class="choice-body">
            <span class="choice-title">Myself</span>
            <span class="choice-note">Mabel will call you, and you choose who else hears how you're getting on.</span>
          </span>
          <span class="choice-check" aria-hidden="true"></span>
        </label>
      </fieldset>

      <div class="step-actions">
        <button type="button" class="btn btn-primary" id="continue-1" disabled>Continue</button>
        <a class="btn-quiet" href="/">Not just now</a>
      </div>
    </section>

    {/* ── Step 2 — Create your account (REAL NAVIGATION BOUNDARY) ───── */}
    <section class="step" data-step="1" id="step-account" hidden>
      <h1>First, let's set up your account.</h1>
      <p class="step-lede">
        This is how you'll come back to check on things and manage the calls.
        No password to remember — use Google, or we'll email you a link.
      </p>

      <div class="auth-panel" id="auth-panel">
        <button type="button" class="btn btn-secondary btn-block" id="google-btn">
          Continue with Google
        </button>

        <div class="divider"><span>or</span></div>

        <form id="magic-form" novalidate>
          <div class="field">
            <label for="enroll-email">Your email address</label>
            <input id="enroll-email" name="email" type="email" required
                   placeholder="you@example.com" autocomplete="email" />
          </div>
          <button type="submit" class="btn btn-primary btn-block" id="magic-btn">
            Send me a sign-in link
          </button>
        </form>

        <p class="fineprint">
          We'll only use this to reach you about your loved one's calls.
        </p>
      </div>

      {/* Shown in place of the panel after a magic link is sent — keeps the
          person inside the flow instead of bouncing them to /auth/check-email,
          since the emailed link returns them here anyway. */}
      <div class="sent-panel" id="sent-panel" hidden>
        <div class="icon-mark">✉</div>
        <h2 class="sent-title">Check your email</h2>
        <p id="sent-to" class="sent-to"></p>
        <p>
          Click the link we just sent and you'll come straight back here to
          carry on. The link works for one hour.
        </p>
        <p class="hint">Don't see it? Have a look in your spam or junk folder.</p>
        <button type="button" class="btn-quiet" id="sent-back">Use a different email</button>
      </div>

      <p id="auth-status" class="status" aria-live="polite"></p>

      <div class="step-actions">
        <button type="button" class="btn btn-secondary" id="back-2">Back</button>
      </div>
    </section>

    {/* ── Step 3 — Who we're calling ─────────────────────────────────── */}
    <section class="step" data-step="2" id="step-recipient" hidden>
      <h1 id="r-heading">Tell us about your loved one.</h1>
      <p class="step-lede" id="r-lede">
        Just the basics — who Mabel is calling, and when suits them best.
      </p>

      <form id="recipient-form" novalidate>
        <div class="field">
          <label for="r-name" id="r-name-label">Their name</label>
          <input id="r-name" name="name" type="text" required autocomplete="name"
                 placeholder="Eleanor" />
          <p class="field-error" id="r-name-error" hidden></p>
        </div>

        <div class="field">
          <label for="r-phone" id="r-phone-label">Their phone number</label>
          <input id="r-phone" name="phone" type="tel" required autocomplete="tel"
                 placeholder="(337) 555-0142" inputmode="tel" />
          <p class="field-hint">A US number Mabel can reach them on.</p>
          <p class="field-error" id="r-phone-error" hidden></p>
        </div>

        <div class="field">
          <label for="r-time">What time of day should she call?</label>
          <select id="r-time" name="call_time"></select>
          <p class="field-hint">Most families pick mid-morning.</p>
        </div>

        <div class="field">
          <label for="r-zip" id="r-zip-label">Their ZIP code</label>
          <input id="r-zip" name="zip" type="text" required inputmode="numeric"
                 maxlength="5" placeholder="70508" autocomplete="postal-code" />
          <p class="field-hint">
            This is how we know to send someone round when a disaster hits their area.
          </p>
          <p class="field-error" id="r-zip-error" hidden></p>
        </div>

        {/* Time-zone confirmation. Never silent: either we show what we
            inferred and offer a way to change it, or — when the ZIP doesn't
            resolve — we ask outright. */}
        <div class="tz-confirm" id="tz-confirm" hidden>
          <p class="tz-line" id="tz-line"></p>
          <button type="button" class="btn-quiet" id="tz-change">That's not right — change it</button>
        </div>

        <div class="field tz-picker" id="tz-picker" hidden>
          <label for="r-tz" id="r-tz-label">Which time zone are they in?</label>
          <select id="r-tz" name="timezone"></select>
          <p class="field-error" id="r-tz-error" hidden></p>
        </div>

        <p id="recipient-status" class="status" aria-live="polite"></p>

        <div class="step-actions">
          <button type="submit" class="btn btn-primary" id="continue-3">Continue</button>
          <button type="button" class="btn-quiet" id="back-3">Back</button>
        </div>
      </form>
    </section>

    {/* ── Step 4 — Emergency contacts ────────────────────────────────── */}
    <section class="step" data-step="3" id="step-contacts" hidden>
      <h1>If Mabel is ever worried, who should we tell?</h1>
      <p class="step-lede" id="c-lede">
        Someone who can check in person, or make a call. We'll only reach out if
        something sounds off.
      </p>

      <form id="contacts-form" novalidate>
        {/* ── contact 1 (required) ── */}
        <fieldset class="contact-card" id="contact-1">
          <legend>First contact</legend>

          <div class="field">
            <label for="c1-name">Their name</label>
            <input id="c1-name" type="text" autocomplete="name" placeholder="Marie Thibodeaux" />
            <p class="field-hint" id="c1-self-hint" hidden></p>
            <p class="field-error" id="c1-name-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="c1-phone">Phone</label>
              <input id="c1-phone" type="tel" inputmode="tel" placeholder="(337) 555-0142" />
            </div>
            <div class="field">
              <label for="c1-email">Email</label>
              <input id="c1-email" type="email" inputmode="email" placeholder="marie@example.com" />
            </div>
          </div>
          <p class="field-hint">We need at least one of these so we can actually reach them.</p>
          <p class="field-error" id="c1-reach-error" hidden></p>

          <div class="field">
            <label for="c1-rel">How do they know them?</label>
            <input id="c1-rel" type="text" placeholder="Daughter" />
          </div>

          <div class="field">
            <span class="pseudo-label">How should we reach them?</span>
            <div class="notify-options" role="group" aria-label="How should we reach them?">
              <label class="notify"><input type="radio" name="c1-notify" value="email" checked /> <span>Email</span></label>
              <label class="notify is-disabled"><input type="radio" name="c1-notify" value="sms" disabled /> <span>Text message</span> <em>coming soon</em></label>
              <label class="notify is-disabled"><input type="radio" name="c1-notify" value="call" disabled /> <span>Phone call</span> <em>coming soon</em></label>
            </div>
          </div>
        </fieldset>

        {/* ── contact 2 (optional, revealed) ── */}
        <button type="button" class="btn btn-secondary add-contact" id="add-contact">
          + Add a second contact
        </button>

        <fieldset class="contact-card" id="contact-2" hidden>
          <legend>Second contact</legend>

          <div class="field">
            <label for="c2-name">Their name</label>
            <input id="c2-name" type="text" autocomplete="name" />
            <p class="field-error" id="c2-name-error" hidden></p>
          </div>

          <div class="field-row">
            <div class="field">
              <label for="c2-phone">Phone</label>
              <input id="c2-phone" type="tel" inputmode="tel" />
            </div>
            <div class="field">
              <label for="c2-email">Email</label>
              <input id="c2-email" type="email" inputmode="email" />
            </div>
          </div>
          <p class="field-hint">At least one, same as above.</p>
          <p class="field-error" id="c2-reach-error" hidden></p>

          <div class="field">
            <label for="c2-rel">How do they know them?</label>
            <input id="c2-rel" type="text" />
          </div>

          <div class="field">
            <span class="pseudo-label">How should we reach them?</span>
            <div class="notify-options" role="group" aria-label="How should we reach them?">
              <label class="notify"><input type="radio" name="c2-notify" value="email" checked /> <span>Email</span></label>
              <label class="notify is-disabled"><input type="radio" name="c2-notify" value="sms" disabled /> <span>Text message</span> <em>coming soon</em></label>
              <label class="notify is-disabled"><input type="radio" name="c2-notify" value="call" disabled /> <span>Phone call</span> <em>coming soon</em></label>
            </div>
          </div>

          <button type="button" class="btn-quiet remove-contact" id="remove-contact">Remove this contact</button>
        </fieldset>

        <p id="contacts-status" class="status" aria-live="polite"></p>

        <div class="step-actions">
          <button type="submit" class="btn btn-primary" id="continue-4">Continue</button>
          <button type="button" class="btn-quiet" id="back-4">Back</button>
        </div>
      </form>
    </section>

    {/* ── Step 5 — Their doctor (optional) ──────────────────────────── */}
    <section class="step" data-step="4" id="step-doctor" hidden>
      <h1 id="d-heading">Their doctor, if you know them.</h1>
      <p class="step-lede" id="d-lede">
        This one's entirely optional — plenty of people skip it, and nothing
        about the calls changes either way.
      </p>

      <form id="doctor-form" novalidate>
        <div class="field">
          <label for="d-name">Doctor's name</label>
          <input id="d-name" type="text" autocomplete="off" placeholder="Dr. Boudreaux" />
        </div>

        <div class="field">
          <label for="d-phone">Doctor's phone</label>
          <input id="d-phone" type="tel" inputmode="tel" placeholder="(337) 555-0188" />
          <p class="field-error" id="d-phone-error" hidden></p>
        </div>

        <p class="reassure">
          We'll include this if we ever need to alert your contacts — we never
          call the doctor automatically.
        </p>

        <p id="doctor-status" class="status" aria-live="polite"></p>

        <div class="step-actions">
          <button type="submit" class="btn btn-primary" id="continue-5">Continue</button>
          <button type="button" class="btn-quiet" id="skip-5">Skip for now</button>
          <button type="button" class="btn-quiet" id="back-5">Back</button>
        </div>
      </form>
    </section>

    {/* ── Step 6 — placeholder. Real content is the next chunk. ─────── */}
    <section class="step" data-step="5" id="step-consent" hidden>
      <h1>Step 6 coming next</h1>
      <p class="step-lede">
        Placeholder. What we saved for the doctor is in the debug strip below —
        those values came back from the database, not from this page.
      </p>
      <div class="step-actions">
        <button type="button" class="btn btn-secondary" id="back-6">Back</button>
      </div>
    </section>

    {/* TEMPORARY — remove before launch. Tracked in the design doc. */}
    <aside class="debug" id="debug">
      <strong>debug (temporary)</strong>
      <code id="debug-state">{'{}'}</code>
    </aside>
  </div>
</BaseLayout>

<script>
  import { getSupabase } from '../scripts/supabase.js';
  import { timezoneForZip, timezoneLabel, TIMEZONES } from '../scripts/zip-timezone.js';

  // ── flow state ────────────────────────────────────────────────────────
  // In-memory only, deliberately — see docs/enrollment-flow-design.md. From
  // step 3 onward this flow holds data about a third party who has not yet
  // consented (consent is step 6), so it is not persisted to the browser.
  //
  // The ONE exception is is_self, which is carried through the auth redirect
  // in the return URL. It is the user's own answer about themselves, contains
  // no third-party data, and without it the post-auth return can't resume.
  // Current-tier limit, not a permanent one — paid tiers raise it later, so it
  // lives here rather than being scattered through the markup and validation.
  const MAX_CONTACTS = 2;

  /** @type {{ is_self: boolean | null, account_id: string | null, recipient_id: string | null, recipient_name: string | null, display_name: string | null, contact_ids: string[], doctor_saved: boolean, doctor_name: string | null, doctor_phone: string | null, step: number }} */
  const state = {
    is_self: null,
    account_id: null,
    recipient_id: null,
    recipient_name: null,
    display_name: null,
    contact_ids: [],
    // Step 5 is optional, so unlike every other step it leaves no row behind to
    // prove it happened. This flag is what the popstate guard checks — "they
    // answered, and the answer was no" is a different state from "they never
    // got there", and only one of them may land on step 6.
    doctor_saved: false,
    doctor_name: null,
    doctor_phone: null,
    step: 1,
  };

  /** @type {(id: string) => HTMLElement} */
  const el = (id) => /** @type {HTMLElement} */ (document.getElementById(id));
  /** @type {(id: string) => HTMLButtonElement} */
  const btn = (id) => /** @type {HTMLButtonElement} */ (document.getElementById(id));

  const stepEls = /** @type {HTMLElement[]} */ (Array.from(document.querySelectorAll('.step')));
  const root = /** @type {HTMLElement} */ (document.querySelector('.enroll'));
  const total = Number(root.dataset.total);
  const fill = el('progress-fill');
  const text = el('progress-text');
  const debugEl = el('debug-state');
  const statusEl = el('auth-status');

  let current = 0;

  /** @type {() => void} */
  function renderDebug() {
    debugEl.textContent = JSON.stringify(state);
    console.log('[enroll] state', { ...state });
  }

  /** @type {(msg: string, tone?: string) => void} */
  function setStatus(msg, tone) {
    statusEl.textContent = msg || '';
    if (tone) statusEl.setAttribute('data-tone', tone);
    else statusEl.removeAttribute('data-tone');
  }

  /** @type {(index: number, opts?: { push?: boolean }) => void} */
  function show(index, { push = true } = {}) {
    if (index < 0 || index >= stepEls.length) return;
    current = index;
    state.step = index + 1;

    stepEls.forEach((node, i) => { node.hidden = i !== index; });

    fill.style.width = (((index + 1) / total) * 100) + '%';
    text.textContent = `Step ${index + 1} of ${total}`;

    const heading = stepEls[index].querySelector('h1');
    if (heading) {
      heading.setAttribute('tabindex', '-1');
      heading.focus({ preventScroll: true });
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });

    if (push) history.pushState({ step: index }, '', location.pathname);
    renderDebug();
  }

  // ── supabase client ───────────────────────────────────────────────────
  // getSupabase() throws when config is missing rather than returning a dead
  // client. Catch it here so Step 2 can SAY the site is misconfigured instead
  // of presenting buttons that silently do nothing.
  /** @type {import('@supabase/supabase-js').SupabaseClient | null} */
  let supabase = null;
  try {
    supabase = getSupabase();
  } catch (err) {
    console.error('[enroll] Supabase not configured:', err);
  }

  // Returns the client, or null after saying loudly that config is missing.
  // Returning the client (rather than a boolean) lets every call site work with
  // a value that is known non-null, instead of re-checking the outer variable.
  function requireSupabase() {
    if (supabase) return supabase;
    setStatus(
      'Sign-in is unavailable: this site is missing its Supabase configuration. ' +
      'Nothing you entered was lost — please try again later.',
      'error'
    );
    return null;
  }

  // Same guard, but reporting into a specific step's status line so the message
  // appears where the person is looking.
  /** @type {(node: HTMLElement) => import('@supabase/supabase-js').SupabaseClient | null} */
  function requireSupabaseFor(node) {
    if (supabase) return supabase;
    node.textContent =
      'We can’t reach our servers right now: this site is missing its configuration. ' +
      'Nothing you entered was lost — please try again later.';
    node.setAttribute('data-tone', 'error');
    return null;
  }

  // ── account: find-or-create ───────────────────────────────────────────
  // Mirrors enrollV2's find-or-create in the engine: someone enrolling a
  // second recipient already has an account and must reuse it.
  /** @type {(sb: import('@supabase/supabase-js').SupabaseClient, session: any) => Promise<string>} */
  async function findOrCreateAccount(sb, session) {
    const { data: existing, error: selErr } = await sb
      .from('accounts')
      .select('id')
      .eq('auth_user_id', session.user.id)
      .maybeSingle();
    if (selErr) throw selErr;
    if (existing) return existing.id;

    const { data: created, error: insErr } = await sb
      .from('accounts')
      .insert({ auth_user_id: session.user.id, email: session.user.email })
      .select('id')
      .single();
    if (insErr) throw insErr;
    return created.id;
  }

  // Where auth should send people back to. Both Google and the magic link
  // funnel through /auth/callback, which honours ?redirect= — so is_self rides
  // along in the return path and one handler covers both providers.
  function buildCallbackUrl() {
    const resume = `/enroll?resume=1&is_self=${state.is_self ? '1' : '0'}`;
    return `${window.location.origin}/auth/callback?redirect=${encodeURIComponent(resume)}`;
  }

  // Settle the account row, then move into step 3.
  /** @type {(sb: import('@supabase/supabase-js').SupabaseClient, session: any) => Promise<void>} */
  async function completeAccountStep(sb, session) {
    setStatus('Setting up your account…');
    try {
      state.account_id = await findOrCreateAccount(sb, session);
      // Kept so Step 3 can prefill when the payer is also the recipient,
      // rather than asking someone for their own name twice.
      const meta = session.user.user_metadata || {};
      state.display_name = meta.full_name || meta.name || null;
      renderDebug();
      setStatus('');
      prepareRecipientStep();
      show(2);
    } catch (err) {
      console.error('[enroll] account create failed', err);
      const detail = err instanceof Error ? err.message : String(err);
      setStatus(`We couldn't finish setting up your account: ${detail}`, 'error');
    }
  }

  // ── step 1 ────────────────────────────────────────────────────────────
  const continueBtn = btn('continue-1');

  document.querySelectorAll('input[name="who-for"]').forEach((node) => {
    const input = /** @type {HTMLInputElement} */ (node);
    input.addEventListener('change', () => {
      state.is_self = input.value === 'myself';
      continueBtn.disabled = false;
      renderDebug();
    });
  });

  continueBtn.addEventListener('click', async () => {
    if (state.is_self === null) return;
    show(1);
    // Already signed in (e.g. adding a second recipient)? Don't make them
    // sign in again — settle the account and move straight on.
    if (supabase) {
      const { data } = await supabase.auth.getSession();
      if (data?.session) await completeAccountStep(supabase, data.session);
    }
  });

  // ── step 2 — auth ─────────────────────────────────────────────────────
  const googleBtn = btn('google-btn');
  const magicForm = /** @type {HTMLFormElement} */ (document.getElementById('magic-form'));
  const magicBtn = btn('magic-btn');
  const emailInput = /** @type {HTMLInputElement} */ (document.getElementById('enroll-email'));
  const authPanel = el('auth-panel');
  const sentPanel = el('sent-panel');

  googleBtn.addEventListener('click', async () => {
    const sb = requireSupabase();
    if (!sb) return;
    setStatus('Taking you to Google…');
    const { error } = await sb.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: buildCallbackUrl() },
    });
    if (error) setStatus(error.message, 'error');
  });

  magicForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const sb = requireSupabase();
    if (!sb) return;

    const email = emailInput.value.trim();
    if (!email) { setStatus('Please enter your email address.', 'error'); return; }

    magicBtn.disabled = true;
    setStatus('Sending your link…');

    const { error } = await sb.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: buildCallbackUrl() },
    });

    if (error) {
      setStatus(error.message, 'error');
      magicBtn.disabled = false;
      return;
    }

    setStatus('');
    el('sent-to').textContent = 'Sent to ' + email;
    authPanel.hidden = true;
    sentPanel.hidden = false;
  });

  btn('sent-back').addEventListener('click', () => {
    sentPanel.hidden = true;
    authPanel.hidden = false;
    magicBtn.disabled = false;
    emailInput.focus();
  });

  btn('back-2').addEventListener('click', () => show(0));
  btn('back-3').addEventListener('click', () => show(1));
  btn('back-4').addEventListener('click', () => show(2));
  btn('back-5').addEventListener('click', () => show(3));
  btn('back-6').addEventListener('click', () => show(4));

  // ── step 4 — emergency contacts ───────────────────────────────────────
  const cForm = /** @type {HTMLFormElement} */ (document.getElementById('contacts-form'));
  const cStatus = el('contacts-status');
  const contact2 = el('contact-2');
  const addContactBtn = btn('add-contact');

  /** @type {(n: number) => { name: HTMLInputElement, phone: HTMLInputElement, email: HTMLInputElement, rel: HTMLInputElement }} */
  const contactFields = (n) => ({
    name: /** @type {HTMLInputElement} */ (document.getElementById(`c${n}-name`)),
    phone: /** @type {HTMLInputElement} */ (document.getElementById(`c${n}-phone`)),
    email: /** @type {HTMLInputElement} */ (document.getElementById(`c${n}-email`)),
    rel: /** @type {HTMLInputElement} */ (document.getElementById(`c${n}-rel`)),
  });

  /** @type {(n: number) => string} */
  function notifyMethod(n) {
    const checked = /** @type {HTMLInputElement | null} */ (
      document.querySelector(`input[name="c${n}-notify"]:checked`)
    );
    return checked ? checked.value : 'email';
  }

  addContactBtn.addEventListener('click', () => {
    contact2.hidden = false;
    addContactBtn.hidden = true;          // enforces the MAX_CONTACTS cap in the UI
    contactFields(2).name.focus();
  });

  btn('remove-contact').addEventListener('click', () => {
    const f = contactFields(2);
    [f.name, f.phone, f.email, f.rel].forEach((i) => { i.value = ''; });
    contact2.hidden = true;
    addContactBtn.hidden = false;
    fieldError('c2-name-error');
    fieldError('c2-reach-error');
  });

  // The nudge for self-signups. Deliberately advisory: someone with nobody else
  // to list must still be able to finish — blocking them would shut out exactly
  // the most isolated people this service exists for.
  function prepareContactsStep() {
    const hint = el('c1-self-hint');
    if (state.is_self && state.recipient_name) {
      hint.textContent = `This should be someone other than ${state.recipient_name} — if Mabel is worried about them, we need to reach somebody else.`;
      hint.hidden = false;
      el('c-lede').textContent =
        "Someone who can look in on you, or give you a call. We'll only reach out if something sounds off.";
    } else {
      hint.hidden = true;
    }
  }

  /** @type {(v: string) => boolean} */
  const looksLikeEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);

  /**
   * Validate one contact block.
   * @type {(n: number, required: boolean) => { ok: boolean, empty: boolean, row: any | null }}
   */
  function readContact(n, required) {
    const f = contactFields(n);
    const name = f.name.value.trim();
    const phoneRaw = f.phone.value.trim();
    const emailRaw = f.email.value.trim();
    const rel = f.rel.value.trim();

    const empty = !name && !phoneRaw && !emailRaw && !rel;
    if (empty && !required) return { ok: true, empty: true, row: null };

    let ok = true;
    if (!name) { fieldError(`c${n}-name-error`, 'Please give us their name.'); ok = false; }

    const phone = phoneRaw ? normalizePhone(phoneRaw) : '';
    if (phoneRaw && !phone) {
      fieldError(`c${n}-reach-error`, "That phone number doesn't look right. Ten digits, like (337) 555-0142.");
      ok = false;
    } else if (emailRaw && !looksLikeEmail(emailRaw)) {
      fieldError(`c${n}-reach-error`, "That email address doesn't look right.");
      ok = false;
    } else if (!phone && !emailRaw) {
      fieldError(`c${n}-reach-error`, 'Please add a phone number or an email so we can reach them.');
      ok = false;
    }

    if (!ok) return { ok: false, empty: false, row: null };

    return {
      ok: true,
      empty: false,
      row: {
        recipient_id: state.recipient_id,
        name,
        phone: phone || null,
        email: emailRaw || null,
        relationship: rel || null,
        notify_method: notifyMethod(n),
      },
    };
  }

  cForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    ['c1-name-error', 'c1-reach-error', 'c2-name-error', 'c2-reach-error'].forEach((id) => fieldError(id));
    cStatus.textContent = '';
    cStatus.removeAttribute('data-tone');

    const first = readContact(1, true);
    const second = contact2.hidden ? { ok: true, empty: true, row: null } : readContact(2, false);
    if (!first.ok || !second.ok) return;

    /** @type {any[]} */
    const rows = [first.row, second.row].filter(Boolean);
    if (rows.length === 0) {
      fieldError('c1-name-error', 'Please add at least one person we can tell.');
      return;
    }
    if (rows.length > MAX_CONTACTS) {
      cStatus.textContent = `You can add up to ${MAX_CONTACTS} contacts for now.`;
      cStatus.setAttribute('data-tone', 'error');
      return;
    }

    const sb = requireSupabaseFor(cStatus);
    if (!sb) return;
    if (!state.recipient_id) {
      cStatus.textContent = "We lost track of who we're calling — please go back a step.";
      cStatus.setAttribute('data-tone', 'error');
      return;
    }

    const submitBtn = btn('continue-4');
    submitBtn.disabled = true;
    cStatus.textContent = 'Saving…';

    try {
      // Re-submitting after a Back must replace, not duplicate. With at most two
      // rows, delete-then-insert is simpler and less error-prone than diffing.
      if (state.contact_ids.length) {
        const { error: delErr } = await sb.from('contacts').delete().in('id', state.contact_ids);
        if (delErr) throw delErr;
        state.contact_ids = [];
      }

      const { data, error } = await sb.from('contacts').insert(rows).select('id');
      if (error) throw error;

      state.contact_ids = (data || []).map((r) => r.id);
      renderDebug();
      cStatus.textContent = '';
      submitBtn.disabled = false;
      prepareDoctorStep();
      show(4);
    } catch (err) {
      console.error('[enroll] contacts insert failed', err);
      const detail = err instanceof Error ? err.message : String(err);
      cStatus.textContent = `We couldn't save those contacts: ${detail}`;
      cStatus.setAttribute('data-tone', 'error');
      submitBtn.disabled = false;
    }
  });

  // ── step 3 — who we're calling ────────────────────────────────────────
  const rForm = /** @type {HTMLFormElement} */ (document.getElementById('recipient-form'));
  const rName = /** @type {HTMLInputElement} */ (document.getElementById('r-name'));
  const rPhone = /** @type {HTMLInputElement} */ (document.getElementById('r-phone'));
  const rZip = /** @type {HTMLInputElement} */ (document.getElementById('r-zip'));
  const rTime = /** @type {HTMLSelectElement} */ (document.getElementById('r-time'));
  const rTz = /** @type {HTMLSelectElement} */ (document.getElementById('r-tz'));
  const tzConfirm = el('tz-confirm');
  const tzPicker = el('tz-picker');
  const tzLine = el('tz-line');
  const rStatus = el('recipient-status');

  // Tracks whether the visible zone came from the ZIP or from the person.
  // Once they override it, a later ZIP edit must not quietly stomp their choice.
  let tzManual = false;

  // Half-hour options, 6:00 AM to 9:00 PM. A plain <select> rather than
  // <input type="time"> — it avoids 24-hour-clock confusion and gives the same
  // control on every browser, which matters for this audience.
  (function buildTimeOptions() {
    for (let mins = 6 * 60; mins <= 21 * 60; mins += 30) {
      const h24 = Math.floor(mins / 60);
      const m = mins % 60;
      const h12 = h24 % 12 === 0 ? 12 : h24 % 12;
      const suffix = h24 < 12 ? 'AM' : 'PM';
      const opt = document.createElement('option');
      opt.value = `${String(h24).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
      opt.textContent = `${h12}:${String(m).padStart(2, '0')} ${suffix}`;
      rTime.appendChild(opt);
    }
    rTime.value = '09:00';
  })();

  (function buildTzOptions() {
    const blank = document.createElement('option');
    blank.value = '';
    blank.textContent = 'Please choose…';
    rTz.appendChild(blank);
    for (const t of TIMEZONES) {
      const opt = document.createElement('option');
      opt.value = t.value;
      opt.textContent = t.label;
      rTz.appendChild(opt);
    }
  })();

  /** @type {(id: string, msg?: string) => void} */
  function fieldError(id, msg) {
    const node = el(id);
    node.textContent = msg || '';
    node.hidden = !msg;
  }

  function clearFieldErrors() {
    ['r-name-error', 'r-phone-error', 'r-zip-error', 'r-tz-error'].forEach((id) => fieldError(id));
    rStatus.textContent = '';
    rStatus.removeAttribute('data-tone');
  }

  // Same rules as the engine's normalizePhone — one behaviour across the stack.
  /** @type {(raw: string) => string} */
  function normalizePhone(raw) {
    const digits = String(raw).replace(/\D/g, '');
    if (digits.length === 10) return '+1' + digits;
    if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;
    return '';
  }

  /** Friendly "9:00 AM" for the confirmation sentence. */
  function selectedTimeLabel() {
    return rTime.options[rTime.selectedIndex]?.textContent || rTime.value;
  }

  function renderTzLine() {
    const tz = rTz.value;
    if (!tz) return;
    tzLine.textContent = `We'll call at ${selectedTimeLabel()} ${timezoneLabel(tz)} — is that right?`;
  }

  // Infer from ZIP, then SHOW IT BACK. Never applied silently, and never
  // guessed when the lookup can't resolve the prefix.
  function applyZipInference() {
    if (tzManual) { renderTzLine(); return; }
    const zip = rZip.value.trim();
    const tz = timezoneForZip(zip);

    if (tz) {
      rTz.value = tz;
      tzConfirm.hidden = false;
      tzPicker.hidden = true;
      renderTzLine();
      fieldError('r-tz-error');
      return;
    }

    // Unresolvable prefix (or incomplete ZIP) → ask outright.
    tzConfirm.hidden = true;
    if (/^\d{5}$/.test(zip)) {
      tzPicker.hidden = false;
      fieldError('r-tz-error', "We couldn't tell which time zone that ZIP is in — please pick it below.");
    } else {
      tzPicker.hidden = true;
    }
  }

  rZip.addEventListener('input', () => {
    rZip.value = rZip.value.replace(/\D/g, '').slice(0, 5);
    applyZipInference();
  });
  rTime.addEventListener('change', renderTzLine);
  rTz.addEventListener('change', () => {
    tzManual = true;
    if (rTz.value) {
      tzConfirm.hidden = false;
      renderTzLine();
      fieldError('r-tz-error');
    }
  });
  btn('tz-change').addEventListener('click', () => {
    tzManual = true;
    tzPicker.hidden = false;
    rTz.focus();
  });

  // Copy differs when the payer is also the recipient — asking someone to
  // "tell us about your loved one" when it's them reads as a mistake.
  function prepareRecipientStep() {
    if (state.is_self) {
      el('r-heading').textContent = 'Just confirming your details.';
      el('r-lede').textContent = "We'll use these to place your daily call.";
      el('r-name-label').textContent = 'Your name';
      el('r-phone-label').textContent = 'Your phone number';
      el('r-zip-label').textContent = 'Your ZIP code';
      el('r-tz-label').textContent = 'Which time zone are you in?';
      if (!rName.value && state.display_name) rName.value = state.display_name;
    } else {
      el('r-heading').textContent = 'Tell us about your loved one.';
      el('r-lede').textContent = 'Just the basics — who Mabel is calling, and when suits them best.';
      el('r-name-label').textContent = 'Their name';
      el('r-phone-label').textContent = 'Their phone number';
      el('r-zip-label').textContent = 'Their ZIP code';
      el('r-tz-label').textContent = 'Which time zone are they in?';
    }
  }

  rForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearFieldErrors();

    const name = rName.value.trim();
    const phone = normalizePhone(rPhone.value);
    const zip = rZip.value.trim();
    const tz = rTz.value;

    let bad = false;
    if (!name) { fieldError('r-name-error', 'Please tell us their name.'); bad = true; }
    if (!phone) {
      fieldError('r-phone-error', "That doesn't look like a US phone number. Ten digits, like (337) 555-0142.");
      bad = true;
    }
    if (!/^\d{5}$/.test(zip)) { fieldError('r-zip-error', 'Please enter a 5-digit ZIP code.'); bad = true; }
    if (!tz) {
      tzPicker.hidden = false;
      fieldError('r-tz-error', 'Please choose a time zone so we call at the right hour.');
      bad = true;
    }
    if (bad) return;

    // Session/config checks come AFTER field validation on purpose: tell people
    // what's wrong with what they typed before raising anything about their
    // account, and never discard a filled-in form to bounce them backwards.
    const sb = requireSupabaseFor(rStatus);
    if (!sb) return;

    if (!state.account_id) {
      rStatus.textContent = 'We lost track of your account — please sign in again.';
      rStatus.setAttribute('data-tone', 'error');
      return;
    }

    const submitBtn = btn('continue-3');
    submitBtn.disabled = true;
    rStatus.textContent = 'Saving…';

    const row = {
      account_id: state.account_id,
      name,
      phone,
      call_time: rTime.value,
      zip,
      timezone: tz,
      is_self: Boolean(state.is_self),
      consent: false,
      verbal_consent: false,
      status: 'pending_payment',
    };

    try {
      // Going Back and pressing Continue again must NOT create a second
      // recipient. Update the row we already made instead of inserting.
      if (state.recipient_id) {
        const { error } = await sb.from('recipients').update(row).eq('id', state.recipient_id);
        if (error) throw error;
      } else {
        const { data, error } = await sb.from('recipients').insert(row).select('id').single();
        if (error) throw error;
        state.recipient_id = data.id;
      }

      state.recipient_name = name;
      renderDebug();
      rStatus.textContent = '';
      submitBtn.disabled = false;
      prepareContactsStep();
      show(3);
    } catch (err) {
      console.error('[enroll] recipient insert failed', err);
      const detail = err instanceof Error ? err.message : String(err);
      rStatus.textContent = `We couldn't save those details: ${detail}`;
      rStatus.setAttribute('data-tone', 'error');
      submitBtn.disabled = false;
    }
  });

  // ── step 5 — their doctor (optional) ──────────────────────────────────
  const dForm = /** @type {HTMLFormElement} */ (document.getElementById('doctor-form'));
  const dName = /** @type {HTMLInputElement} */ (document.getElementById('d-name'));
  const dPhone = /** @type {HTMLInputElement} */ (document.getElementById('d-phone'));
  const dStatus = el('doctor-status');

  function prepareDoctorStep() {
    if (state.is_self) {
      el('d-heading').textContent = 'Your doctor, if you’d like to tell us.';
      el('d-lede').textContent =
        "Entirely optional — plenty of people skip it, and nothing about your calls changes either way.";
    } else if (state.recipient_name) {
      el('d-heading').textContent = `${state.recipient_name}’s doctor, if you know them.`;
    }
  }

  /**
   * The one write this step makes. Only ever an UPDATE: by the time anyone can
   * reach step 5 the recipients row exists, so there is no insert branch here
   * that could strand a second row.
   *
   * @type {(doctorName: string | null, doctorPhone: string | null) => Promise<void>}
   */
  async function saveDoctor(doctorName, doctorPhone) {
    const sb = requireSupabaseFor(dStatus);
    if (!sb) return;
    if (!state.recipient_id) {
      dStatus.textContent = "We lost track of who we're calling — please go back a step.";
      dStatus.setAttribute('data-tone', 'error');
      return;
    }

    const continueBtn5 = btn('continue-5');
    const skipBtn = btn('skip-5');
    continueBtn5.disabled = true;
    skipBtn.disabled = true;
    dStatus.textContent = 'Saving…';

    try {
      // Read the row back rather than trusting the update: this is the only
      // place that can confirm from the browser that we changed the row we
      // meant to and that the values actually landed.
      const { data, error } = await sb
        .from('recipients')
        .update({ doctor_name: doctorName, doctor_phone: doctorPhone })
        .eq('id', state.recipient_id)
        .select('id, doctor_name, doctor_phone')
        .single();
      if (error) throw error;

      // An id that came back different would mean we'd written to someone
      // else's recipient. Halt loudly rather than carry on into consent.
      if (data.id !== state.recipient_id) {
        throw new Error(`Updated the wrong record (expected ${state.recipient_id}, got ${data.id}).`);
      }

      state.doctor_name = data.doctor_name;
      state.doctor_phone = data.doctor_phone;
      state.doctor_saved = true;
      renderDebug();
      dStatus.textContent = '';
      continueBtn5.disabled = false;
      skipBtn.disabled = false;
      show(5);
    } catch (err) {
      console.error('[enroll] doctor update failed', err);
      const detail = err instanceof Error ? err.message : String(err);
      dStatus.textContent = `We couldn't save the doctor's details: ${detail}`;
      dStatus.setAttribute('data-tone', 'error');
      continueBtn5.disabled = false;
      skipBtn.disabled = false;
    }
  }

  dForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    fieldError('d-phone-error');
    dStatus.textContent = '';
    dStatus.removeAttribute('data-tone');

    const name = dName.value.trim();
    const phoneRaw = dPhone.value.trim();

    // Empty is a valid answer. Only a number they actually typed can be wrong.
    const phone = phoneRaw ? normalizePhone(phoneRaw) : '';
    if (phoneRaw && !phone) {
      fieldError('d-phone-error', "That doesn't look like a US phone number. Ten digits, like (337) 555-0188.");
      return;
    }

    await saveDoctor(name || null, phone || null);
  });

  // Skipping records "no doctor" rather than leaving the columns untouched —
  // it's an answer we asked for and got, not a question we failed to ask.
  btn('skip-5').addEventListener('click', async () => {
    fieldError('d-phone-error');
    dName.value = '';
    dPhone.value = '';
    await saveDoctor(null, null);
  });

  // ── within-flow back/forward ──────────────────────────────────────────
  window.addEventListener('popstate', (e) => {
    const target = e.state && typeof e.state.step === 'number' ? e.state.step : 0;
    if (state.is_self === null) { show(0, { push: false }); return; }
    // Never land past a step whose prerequisite row doesn't exist yet.
    if (target >= 2 && !state.account_id) { show(1, { push: false }); return; }
    if (target >= 3 && !state.recipient_id) { show(2, { push: false }); return; }
    if (target >= 4 && !state.contact_ids.length) { show(3, { push: false }); return; }
    if (target >= 5 && !state.doctor_saved) { show(4, { push: false }); return; }
    show(target, { push: false });
  });

  // ── resume after the auth round-trip ──────────────────────────────────
  // /auth/callback sends people back here as /enroll?resume=1&is_self=0|1
  // after both Google OAuth and the magic link.
  async function boot() {
    const params = new URLSearchParams(window.location.search);

    if (params.get('resume') === '1') {
      state.is_self = params.get('is_self') === '1';
      // Clean the params off the URL so a later reload doesn't look resumable.
      history.replaceState({ step: 1 }, '', '/enroll');

      if (!supabase) {
        show(1, { push: false });
        requireSupabase();
        return;
      }
      const { data } = await supabase.auth.getSession();
      if (data?.session) {
        show(1, { push: false });
        await completeAccountStep(supabase, data.session);
        return;
      }
      // Resumed without a session — the sign-in didn't complete. Say so
      // rather than silently restarting.
      show(1, { push: false });
      setStatus('That sign-in didn’t complete. Please try again.', 'error');
      return;
    }

    history.replaceState({ step: 0 }, '', location.pathname);
    show(0, { push: false });
  }

  boot();
</script>

<style>
  .enroll { max-width: 44rem; padding-top: 2.5rem; }

  .progress { margin-bottom: 2.75rem; }
  .progress-track { height: 4px; background: var(--line); border-radius: 999px; overflow: hidden; }
  .progress-fill {
    height: 100%; width: 12.5%; background: var(--gold);
    border-radius: 999px; transition: width 0.4s ease;
  }
  .progress-text {
    margin: 0.6rem 0 0; font-size: 0.78rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--soft-ink); font-weight: 500;
  }

  .step h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 600; margin-bottom: 0.6rem; }
  .step h1:focus { outline: none; }
  .step-lede { font-size: 1.08rem; color: var(--soft-ink); max-width: 40ch; margin: 0 0 2.25rem; }

  /* ── choice cards ─────────────────────────────────────────────────── */
  .choices { border: 0; padding: 0; margin: 0 0 2.25rem; display: grid; gap: 14px; }
  .choice {
    position: relative; display: flex; align-items: flex-start; gap: 16px;
    padding: 26px 60px 26px 28px; background: var(--paper);
    border: 1px solid var(--line); border-radius: 20px; cursor: pointer;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .choice:hover { border-color: var(--rose); transform: translateY(-1px); }
  .choice input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .choice:focus-within { outline: 3px solid var(--rose); outline-offset: 2px; }
  .choice:has(input:checked) {
    border-color: var(--rose);
    box-shadow: 0 0 0 1px var(--rose), 0 18px 36px -24px rgba(45, 36, 23, 0.4);
    background: #fffdf8;
  }
  .choice-body { display: block; }
  .choice-title {
    display: block; font-family: var(--font-head); font-weight: 600;
    font-size: 1.3rem; color: var(--ink); line-height: 1.2;
  }
  .choice-note {
    display: block; margin-top: 6px; font-size: 0.95rem;
    font-weight: 300; color: var(--soft-ink); max-width: 42ch;
  }
  .choice-check {
    position: absolute; right: 26px; top: 50%; transform: translateY(-50%);
    width: 26px; height: 26px; border-radius: 50%;
    border: 2px solid var(--line); background: var(--cream);
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .choice:has(input:checked) .choice-check {
    border-color: var(--rose); background: var(--rose);
    box-shadow: inset 0 0 0 4px var(--paper);
  }

  /* ── step 2 auth panel ────────────────────────────────────────────── */
  .auth-panel, .sent-panel {
    background: var(--paper); border: 1px solid var(--line);
    border-radius: 20px; padding: 30px 28px; margin-bottom: 1.5rem;
  }
  .sent-panel { text-align: center; }
  .sent-title { font-size: 1.5rem; margin-bottom: 0.4rem; }
  .sent-to {
    font-family: var(--font-head); color: var(--rose-deep);
    margin: 0 0 1rem; word-break: break-all;
  }
  .sent-panel p { color: var(--soft-ink); margin: 0 0 0.75rem; }
  .fineprint {
    font-size: 0.82rem; color: var(--soft-ink); font-weight: 300;
    margin: 1.1rem 0 0; text-align: center;
  }

  /* ── shared field styling for every step in the flow ──────────────────
     Keyed to .field, NOT to a form id. These rules were originally written
     twice, once per form (#recipient-form, #contacts-form), which meant each
     new step silently rendered bare browser inputs until someone remembered to
     paste the block again — step 5 did exactly that. Any step that wraps a
     control in .field is now styled by default; forgetting is no longer
     possible, and there is one place to change the look of a field. */
  .field { margin-bottom: 1.5rem; }
  .field input[type='text'],
  .field input[type='tel'],
  .field input[type='email'],
  .field select {
    width: 100%;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 400;
    padding: 15px 18px;
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .field input:focus,
  .field select:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(217, 164, 65, 0.4);
  }
  .field label,
  .pseudo-label {
    display: block;
    font-family: var(--font-head);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.45rem;
  }
  .field-hint {
    margin: 0.4rem 0 0;
