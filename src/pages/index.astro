<script>
  // Sample call player.
  //
  // The block ships HIDDEN and only appears once /audio/sample-call.mp3 is
  // confirmed to exist. The recording is being made separately, and a play
  // button that silently does nothing reads as a broken site — worse than
  // showing nothing at all. A HEAD request is enough: on Cloudflare Pages a
  // missing asset answers 404, so this is a real check and not a guess.
  // querySelector with a type argument, not getElementById: the latter returns
  // a bare HTMLElement, so every audio-specific property below (play, duration,
  // currentTime) was an editor error even though it ran fine.
  const wrap = document.querySelector<HTMLElement>('#sample-call');
  const audio = document.querySelector<HTMLAudioElement>('#sample-audio');
  const btn = document.querySelector<HTMLButtonElement>('#sample-play');
  const bar = document.querySelector<HTMLElement>('#sample-bar span');
  const time = document.querySelector<HTMLElement>('#sample-time');

  if (wrap && audio && btn && bar && time) {
    const fmt = (s: number) => {
      if (!Number.isFinite(s)) return '0:00';
      const m = Math.floor(s / 60);
      return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    };

    fetch(audio.src, { method: 'HEAD' })
      .then((r) => {
        // Content-Type guards against a 200 that is actually the SPA/404 page.
        const ok = r.ok && !(r.headers.get('content-type') || '').includes('text/html');
        if (ok) wrap.hidden = false;
      })
      .catch(() => {
        /* Offline or blocked — stay hidden. Nothing here is load-bearing. */
      });

    btn.addEventListener('click', () => {
      if (audio.paused) audio.play().catch(() => setPlaying(false));
      else audio.pause();
    });

    const setPlaying = (on: boolean) => {
      btn.setAttribute('data-playing', String(on));
      btn.setAttribute('aria-label', on ? 'Pause the sample call' : 'Play the sample call');
    };
    audio.addEventListener('play', () => setPlaying(true));
    audio.addEventListener('pause', () => setPlaying(false));

    audio.addEventListener('loadedmetadata', () => { time.textContent = fmt(audio.duration); });
    audio.addEventListener('timeupdate', () => {
      if (audio.duration) bar.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
      // Counts DOWN while playing — how much is left is the useful number.
      time.textContent = fmt(audio.duration ? audio.duration - audio.currentTime : 0);
    });
    audio.addEventListener('ended', () => {
      setPlaying(false);
      bar.style.width = '0%';
      audio.currentTime = 0;
      time.textContent = fmt(audio.duration);
    });
    // If the file disappears or is corrupt, retreat rather than sit there dead.
    audio.addEventListener('error', () => { wrap.hidden = true; });
  }
</script>
