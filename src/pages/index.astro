---
// Home page — a faithful Astro rebuild of the live auntmabel.app landing page.
//
// Copy, section order, palette, and type all come from docs/brand-capture.md.
// Anything that differs from the capture is marked CHANGED below and nowhere
// else — if you find yourself "improving" the copy, update the capture first.
//
// CHANGED from the live page (the funnel, per brief 2026-08-06):
//   - hero eyebrow  "Coming soon · join the waitlist"  →  "Now enrolling — $39/month"
//   - the email-only Formspree waitlist form is GONE; the CTA band now sends
//     people to /enroll via a "Set up a daily call" button.
//   - the CTA band's waitlist-specific copy (h2/sub/fine print) is rewritten
//     to match, since the captured wording described collecting an email.
// Everything else is verbatim from the capture.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aunt Mabel — Daily Check-In Calls for Elderly Loved Ones Living Alone"
  description="A warm daily phone call for your elderly parent or grandparent living alone — and family reached instantly the moment something's wrong. 3 days free. In partnership with the Cajun Navy Ground Force."
  ogTitle="A friendly call every day — and someone there when it matters most."
  ogDescription="Aunt Mabel calls your elderly loved one every morning for a warm check-in — and reaches you live, in seconds, if something's ever wrong. 3 days free."
>
  <Fragment slot="head">
    {/*
      Three JSON-LD blocks. These are read by Google for rich results AND by AI
      answer engines deciding how to describe this service — which is why the
      FAQ answers below repeat the 911-first posture rather than only selling.
      An assistant that summarises us as an emergency service would be doing
      real harm, so the correction is written where the machines read.

      set:html with JSON.stringify, never a raw template string: a stray
      apostrophe in the copy would otherwise produce invalid JSON that fails
      silently — the block simply stops counting, with nothing on screen to show
      for it.
    */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Aunt Mabel',
        legalName: 'Trustlight LLC',
        url: 'https://auntmabel.app',
        logo: 'https://auntmabel.app/og-image.jpg',
        email: 'Mabel@AuntMabel.app',
        description:
          'Aunt Mabel is a daily wellness check-in call service for elderly people living alone, operated by Trustlight LLC in partnership with the Cajun Navy Ground Force.',
        address: { '@type': 'PostalAddress', addressRegion: 'LA', addressCountry: 'US' },
        sameAs: [],
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: 'Aunt Mabel Daily Check-In Calls',
        serviceType: 'Daily wellness check-in calls for elderly people living alone',
        provider: { '@type': 'Organization', name: 'Trustlight LLC' },
        areaServed: 'US',
        description:
          'A warm daily phone call that checks on an elderly loved one’s meals, medications, and wellbeing — with live family escalation (Family Connect) the moment something is wrong, and in-person disaster checks in partnership with the Cajun Navy Ground Force.',
        offers: {
          '@type': 'Offer',
          price: '39.00',
          priceCurrency: 'USD',
          description: 'Monthly subscription with a 3-day free trial.',
        },
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          [
            'What is Aunt Mabel?',
            'Aunt Mabel is a service that places a warm, friendly phone call to an elderly person living alone every day, checks on their meals, medications, and wellbeing, and reaches their family immediately if something is wrong. It is operated by Trustlight LLC in partnership with the Cajun Navy Ground Force.',
          ],
          [
            'How does the daily check-in call work?',
            'Every day at a time the family chooses, Aunt Mabel calls the elderly person for a warm conversation — how they slept, whether they’ve eaten, how they’re feeling. The family sees a summary of every call in their dashboard.',
          ],
          [
            'What happens if something is wrong during a call?',
            'Mabel urges the person to call 911 for any emergency, and at the same time reaches their family — bringing a family member onto the call live, so they’re never alone. Aunt Mabel is not an emergency service, and 911 always comes first.',
          ],
          [
            'Is Aunt Mabel a medical or emergency service?',
            'No. Aunt Mabel is a friendly daily check-in and a fast way to reach family — not an emergency service, medical device, or monitoring system. For any real emergency, always call 911.',
          ],
          [
            'How much does Aunt Mabel cost?',
            'Aunt Mabel is $39 per month with a 3-day free trial — you’re not charged until your loved one has welcomed the calls. Cancel anytime, no contracts.',
          ],
          [
            'What happens during a disaster?',
            'Aunt Mabel is built in partnership with the Cajun Navy Ground Force. When a disaster strikes a recipient’s area, the daily call becomes an in-person wellness check — a commitment to try, from people who have spent years showing up after storms.',
          ],
        ].map(([q, a]) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      })}
    />
    <meta
      name="keywords"
      content="elderly wellness check, senior check-in call, daily call for seniors, elderly parent care, automated senior check-in, disaster wellness check, check on elderly parents, senior safety service, aging parent monitoring, elderly disaster relief, AI check-in call, daily wellness call, senior isolation, care for aging parents, in-person wellness check, Cajun Navy Ground Force, elderly disaster preparedness, remote elderly care, peace of mind for families, scheduled check-in calls"
    />
    {/*
      REMOVED, deliberately — do not restore:

      1. A second `Service` block naming **Cajun Navy Ground Force as the
         provider**, carrying the nonprofit's own address, email and telephone.
         That is the exact error docs/AUNT-MABEL.md § Entity & naming exists to
         prevent — and it was the MACHINE-READABLE copy, the version Google and
         AI assistants repeat when asked who runs this service. Trustlight LLC
         is the operator; CNGF is the disaster-response partner. The Service
         block above now says so.

      2. geo.placename "Lafayette, Louisiana" and its coordinates. Venue was
         resolved to Orleans Parish, and pinning a nationwide service to a city
         we do not operate from only suppresses it elsewhere. The lighter
         US-LA / Louisiana pair now lives in BaseLayout for every page.
    */}
  </Fragment>

  {/* ── hero ────────────────────────────────────────────────────────── */}
  <div class="wrap">
    <div class="hero">
      <div>
        {/* CHANGED: was "Coming soon · join the waitlist" */}
        <p class="eyebrow">Now enrolling — $39/month</p>
        <h1>A friendly call every day — <em>and a knock on the door when disaster strikes.</em></h1>
        <p class="lede">
          List your elderly parent and Aunt Mabel checks in on the schedule you
          choose. When a disaster hits their area, that same call becomes an
          in-person wellness check from Ground Force.
        </p>
      </div>

      {/* demo-call card */}
      <div class="phone-card">
        <div class="caller">
          <span class="av"></span>
          <div>
            <div class="nm">Aunt Mabel</div>
            <div class="st"><span class="ring"></span>calling Eleanor…</div>
          </div>
        </div>
        <p class="bubble">"Morning, Eleanor. It's Mabel, just checking in on you. How'd you sleep, hon?"</p>
        <p class="bubble">"You have your breakfast yet this morning?"</p>
        <p class="bubble">"Alright, sweetheart. I'll ring you again tomorrow. You take care now."</p>
        {/* AI disclosure #1 of 2 — never remove; the live page discloses twice. */}
        <p class="ai-note">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="6.3" stroke="#6b5d48" stroke-width="1.2" />
            <path d="M7 6.2v3.4M7 4.3v.1" stroke="#6b5d48" stroke-width="1.3" stroke-linecap="round" />
          </svg>
          Aunt Mabel is a friendly AI voice that places the calls automatically, on your schedule.
        </p>
      </div>
    </div>
  </div>

  <div class="wrap sections">
    {/* ── CTA band (replaces the waitlist form) ─────────────────────── */}
    <section>
      <div class="band-dark cta-band" id="enroll-cta">
        <p class="kicker">Be among the first families</p>
        <h2>Set up her first call.</h2>
        {/* CHANGED: was the waitlist's "leave your email" copy. */}
        <p class="sub">
          Tell Mabel who to call and when. She starts the next morning — and you
          can stop the calls at any time.
        </p>
        <p class="cta-actions">
          <a class="btn btn-primary" href="/enroll">Set up a daily call</a>
        </p>
        <p class="tiny">$39 a month · cancel anytime · no long-term contract.</p>
      </div>
    </section>

    {/* ── story ─────────────────────────────────────────────────────── */}
    <section>
      <div class="story">
        <p class="kicker">A true story from the field</p>
        <h2>The house on Verret Street.</h2>
        <p>
          The water came up in the night. By the time Ground Force teams reached
          the neighborhood the next morning — boats first, then boots — most of
          the able-bodied had already gotten themselves to the shelter. They'd
          packed a bag, called a cousin, climbed into a truck bed. The young and
          the connected move fast.
        </p>
        <p>But in the small brick house on Verret Street, the door was still shut.</p>
        <p>
          Inside, Miss Eleanor was sitting in her chair in two feet of water,
          exactly where she'd been when the power died eighteen hours earlier.
          Eighty-one years old. Her phone was dead. Her daughter lived four
          states away and had been calling and calling, getting nothing,
          assuming the lines were just down like everyone else's. Eleanor wasn't
          hurt. She was something quieter and worse than hurt — she was
          <em>alone</em>, with no way to tell anyone, and no one whose job it
          was to come find her specifically.
        </p>
        <p>
          The team got her out. She was fine. But across twenty disaster
          responses, the same door keeps showing up. Different street, different
          name, same shut door. The elderly are the last to be reached and the
          first to be forgotten — not because anyone is cruel, but because no
          system is pointed at them <em>by name</em> until it's already too late.
        </p>
        <p class="story-close">
          That's the gap. Not a lack of compassion — a lack of a tripwire. Nobody
          knew Eleanor was there until someone physically opened the door.
          <strong>Aunt Mabel is that tripwire.</strong>
        </p>
      </div>
    </section>

    {/* ── why we built her ──────────────────────────────────────────── */}
    <section>
      <div class="band-dark why">
        <p class="kicker">Why we built her</p>
        <h2>We've seen what happens when no one checks in.</h2>
        <p>
          Ground Force has responded to <strong>20 disasters</strong>, and in
          community after community we found the same thing: elderly neighbors
          completely alone. Many disabled. Many physically unable to clear
          debris or repair their own homes — and with no one coming to help.
        </p>
        <p>
          When we're in trouble, help usually comes from our friends. But the
          elderly often have <strong>few close friends left</strong>. Spouses
          and friends pass on, families live far away, mobility fades, and the
          world gets quiet. <strong>Social isolation is the single most
          troubling factor</strong> standing between an older person and a safe
          recovery — and it doesn't only happen after a storm. For too many,
          it's every day.
        </p>
        <p>
          Aunt Mabel grew out of that mission: to be a safety net for the
          elderly and vulnerable. A simple, warm daily call so someone is always
          checking in — and so a family member always knows their loved one is
          okay.
        </p>
        <div class="stat-row">
          <div class="stat">
            <div class="n">184%</div>
            <div class="l">growth in Americans over 65 since 1980</div>
          </div>
          <div class="stat">
            <div class="n">72M</div>
            <div class="l">elderly Americans today, and climbing</div>
          </div>
          <div class="stat">
            <div class="n">1 call</div>
            <div class="l">a day can be the difference between alone and looked after</div>
          </div>
        </div>
      </div>
    </section>

    {/* ── how it works ──────────────────────────────────────────────── */}
    <section>
      <p class="kicker">How it works</p>
      <h2>Peace of mind, without the hovering.</h2>
      <div class="steps">
        <div class="step">
          <div class="n">1</div>
          <h3>Tell Mabel who to call</h3>
          <p>Add your loved one's name, number, and the time of day that suits them best.</p>
        </div>
        <div class="step">
          <div class="n">2</div>
          <h3>She calls, on schedule</h3>
          {/* AI disclosure #2 of 2 — never remove. */}
          <p>
            A warm, natural conversation — not a checklist. She asks how they
            slept, if they've eaten, how they're feeling. It's an AI voice,
            calling automatically so it never gets missed.
          </p>
        </div>
        <div class="step">
          <div class="n">3</div>
          <h3>You get the all-clear</h3>
          <p>A simple daily note that they're okay. And if something sounds off, you're the first to know.</p>
        </div>
      </div>
    </section>

    {/* ── two ways she shows up ─────────────────────────────────────── */}
    <section>
      <p class="kicker">Two ways she shows up</p>
      <h2>The same enrollment. Two levels of care.</h2>
      <div class="modes">
        <div class="mode mode-day">
          <span class="mode-tag">Every day</span>
          <h3>The everyday call</h3>
          <p>
            On the schedule you choose — daily, weekdays, mornings or evenings —
            Aunt Mabel calls to ask how they slept, if they've eaten, and how
            they're feeling. A warm voice, a steady rhythm, and a quiet note to
            you that all is well.
          </p>
        </div>
        <div class="mode mode-storm">
          <span class="mode-tag">When disaster strikes</span>
          <h3>The in-person check</h3>
          <p>
            When a storm or disaster hits their area, the call escalates. Ground
            Force's trained teams — already on the ground in impacted
            communities — go knock on the door for a real wellness check, so
            your loved one is never left alone in the chaos.
          </p>
        </div>
      </div>
    </section>

    {/* ── trust strip ───────────────────────────────────────────────── */}
    <section>
      <div class="strip">
        <div class="item">
          <h4>Warm, not clinical</h4>
          <p>Mabel sounds like family, not a service. The call is the point — never a task to rush through.</p>
        </div>
        <div class="item">
          <h4>You set the rhythm</h4>
          <p>Daily, weekdays, mornings or evenings — whatever fits their routine and yours.</p>
        </div>
        <div class="item">
          <h4>Backed by boots on the ground</h4>
          <p>If a call is missed or a disaster strikes, Ground Force is ready to step in — in person when it counts.</p>
        </div>
      </div>
    </section>

    {/* ── who she was ───────────────────────────────────────────────────
        Teaser to /story. The thumbnail is a placeholder frame until her
        portrait is in public/images/family/ — see src/pages/story.astro. */}
    <section class="story-teaser">
      <a class="story-teaser-inner" href="/story">
        <div class="teaser-portrait" aria-hidden="true"><span>Photo</span></div>
        <div>
          <p>
            Aunt Mabel was a real person — the founder's great-aunt, a woman who
            remembered every family member's name. Her photo is our logo. Her spirit
            is the whole idea.
          </p>
          <span class="teaser-link">Read our story →</span>
        </div>
      </a>
    </section>
  </div>
</BaseLayout>

<script>
  // ── auth-return rescue ────────────────────────────────────────────────
  // Supabase validates redirectTo against its Redirect URLs allowlist. When the
  // URL we ask for is NOT allowlisted it does not error — it silently falls back
  // to the project's Site URL, dropping the browser on "/" with the auth code
  // still in the query string. The sign-in actually succeeded; the code just
  // landed on a page that ignores it.
  //
  // This forwards such a landing to /auth/callback, which knows how to finish
  // the exchange and honour ?redirect=. It fires only when auth-shaped params
  // are present, so an ordinary visit is untouched.
  //
  // This is a safety net, NOT the fix. The fix is allowlisting the callback URL
  // in Supabase. The net only helps when Site URL points at a domain this app
  // serves — it cannot rescue a fallback to some other site.
  (() => {
    const q = new URLSearchParams(window.location.search);
    if (!(q.has('code') || q.has('error_description') || q.has('error_code'))) return;
    console.warn('[auth] Auth params landed on "/" — Supabase likely fell back to Site URL. Forwarding to /auth/callback.');
    window.location.replace('/auth/callback' + window.location.search + window.location.hash);
  })();
</script>

<style>
  /* Home-page layout only. Tokens, buttons, .band-dark, .kicker and the type
     scale all live in src/styles/site.css — nothing is redefined here. */

  .sections > section { padding: 8px 0 64px; }

  /* ── hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding: 64px 0 50px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 54px;
    align-items: center;
  }

  /* ── demo-call card ───────────────────────────────────────────────── */
  .phone-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 26px;
    padding: 28px 26px;
    box-shadow: 0 30px 60px -28px rgba(45, 36, 23, 0.35), 0 2px 0 #fff inset;
    transform: rotate(1.3deg);
    position: relative;
  }
  .phone-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 26px;
    box-shadow: 0 0 0 8px var(--cream);
    pointer-events: none;
  }
  .caller { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .caller .av {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--gold), var(--rose));
    flex: none;
    box-shadow: 0 6px 16px rgba(194, 91, 80, 0.4);
  }
  .caller .nm { font-family: var(--font-head); font-weight: 600; font-size: 1.18rem; line-height: 1; }
  .caller .st { font-size: 0.8rem; color: var(--sage); font-weight: 500; margin-top: 4px; }
  .bubble {
    background: var(--cream);
    border-radius: 16px 16px 16px 4px;
    padding: 13px 16px;
    font-size: 1rem;
    color: var(--ink);
    margin: 0 0 9px;
    font-family: var(--font-head);
    font-weight: 400;
    line-height: 1.45;
  }
  .ring {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sage);
    margin-right: 6px;
    animation: pulse 1.6s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.35; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.1); }
  }
  .ai-note {
    font-size: 0.78rem;
    color: var(--soft-ink);
    margin: 14px 0 0;
    font-weight: 400;
    display: flex;
    gap: 7px;
    align-items: flex-start;
  }
  .ai-note svg { flex: none; margin-top: 2px; }

  /* ── CTA band ─────────────────────────────────────────────────────── */
  .cta-band { text-align: center; }
  .cta-band::before {
    content: '';
    position: absolute;
    left: -50px;
    bottom: -50px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(217, 164, 65, 0.18), transparent 70%);
  }
  .cta-band h2 { margin: 0 auto 14px; }
  .cta-band .sub { font-size: 1.08rem; max-width: 44ch; margin: 0 auto 30px; }
  .cta-actions { position: relative; z-index: 2; margin: 0; }
  .cta-band .tiny { margin-top: 18px; position: relative; z-index: 2; }

  /* ── story ────────────────────────────────────────────────────────── */
  .story {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 4px solid var(--gold);
    border-radius: 22px;
    padding: 50px 52px;
  }
  .story h2 { max-width: 24ch; }
  .story p {
    font-family: var(--font-head);
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--ink);
    font-weight: 400;
    max-width: 60ch;
    margin: 0 0 18px;
  }
  .story p em { font-style: italic; color: var(--rose-deep); }
  .story .story-close {
    font-family: var(--font-body);
    font-size: 1.18rem;
    font-weight: 300;
    color: var(--soft-ink);
    border-top: 1px solid var(--line);
    padding-top: 22px;
    margin-top: 28px;
  }
  .story .story-close strong { color: var(--rose); font-weight: 600; }

  /* ── why band ─────────────────────────────────────────────────────── */
  .why::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -60px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(122, 182, 72, 0.22), transparent 70%);
  }
  .why h2 { max-width: 24ch; }
  .why p { font-size: 1.08rem; max-width: 60ch; margin-bottom: 16px; position: relative; z-index: 2; }
  .why p strong { color: var(--paper); font-weight: 500; }
  .stat-row { display: flex; gap: 40px; margin-top: 34px; flex-wrap: wrap; position: relative; z-index: 2; }
  .stat .n { font-family: var(--font-head); font-weight: 900; font-size: 2.6rem; color: var(--gf-green); line-height: 1; }
  .stat .l { font-size: 0.92rem; color: var(--on-dark); font-weight: 300; max-width: 22ch; margin-top: 6px; }

  /* ── how it works ─────────────────────────────────────────────────── */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .step .n { font-family: var(--font-head); font-weight: 900; font-size: 2.3rem; color: var(--line); line-height: 1; margin-bottom: 8px; }
  .step h3 { margin-bottom: 8px; }
  .step p { color: var(--soft-ink); font-size: 1rem; font-weight: 300; margin: 0; }

  /* ── modes ────────────────────────────────────────────────────────── */
  .modes { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .mode { border-radius: 20px; padding: 34px 32px; border: 1px solid var(--line); }
  .mode-day { background: var(--paper); }
  .mode-storm { background: var(--ink); border-color: var(--ink); }
  .mode-tag {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 30px;
    margin-bottom: 16px;
  }
  .mode-day .mode-tag { background: var(--cream); color: var(--sage); }
  .mode-storm .mode-tag { background: rgba(122, 182, 72, 0.16); color: var(--gf-green); }
  .mode h3 { font-size: 1.4rem; margin-bottom: 10px; }
  .mode-storm h3 { color: var(--paper); }
  .mode p { font-size: 1rem; font-weight: 300; color: var(--soft-ink); margin: 0; }
  .mode-storm p { color: var(--on-dark); }

  /* ── trust strip ──────────────────────────────────────────────────── */
  .strip {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 42px 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
  }
  .strip .item h4 {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1.08rem;
    margin: 0 0 6px;
    color: var(--rose-deep);
  }
  .strip .item p { font-size: 0.96rem; color: var(--soft-ink); font-weight: 300; margin: 0; }

  /* ── responsive — one breakpoint, matching the live page ──────────── */
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 38px; padding: 44px 0; }
    .phone-card { transform: rotate(0); max-width: 380px; }
    .steps { grid-template-columns: 1fr; gap: 24px; }
    .strip { grid-template-columns: 1fr; padding: 34px 28px; }
    .modes { grid-template-columns: 1fr; gap: 16px; }
    .mode { padding: 28px 24px; }
    .story { padding: 36px 26px; }
    .stat-row { gap: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring { animation: none; opacity: 0.8; }
  }
</style>
