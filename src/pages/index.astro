---
// Home page — rebuilt from the Claude Design mockup.
//
// The mockup ships inline styles plus Claude Design's own sc-if / style-hover
// syntax, none of which is our stack. Rebuilt as semantic markup with a scoped
// stylesheet: every colour, size and string is the mockup's, each sc-if wrapper
// renders unconditionally (they were conditional chrome, not content), and each
// style-hover became a real CSS :hover rule.
//
// Header and footer come from the SHARED components via BaseLayout. They were
// duplicated here at first and had already drifted from the rest of the site —
// different mark, different nav, different footer links. The mockup's header
// styling now lives in src/components/SiteHeader.astro, so there is exactly one
// place to change it.
//
// The hero photograph is real: a son kissing his mother's forehead. It is
// pre-cropped from 3:2 to the frame's 4:5 by scripts/build-hero.mjs, framed
// around the two faces rather than the centre of the picture — a centred crop
// clipped his face at the left edge. Re-run that script after any change to
// the source, which is kept alongside it as hero-family-source.jpg.
//
// The mockup's own footer markup was truncated mid-attribute in the extract, so
// the footer below is reconstructed from the brief's specified contents.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aunt Mabel — Daily Check-In Calls for Elderly Loved Ones Living Alone"
  description="A warm daily phone call for your elderly parent or grandparent living alone — and family reached instantly the moment something's wrong. 14 days free. Born from years of disaster response with the Cajun Navy Ground Force."
  ogTitle="A friendly call every day — and someone there when it matters most."
  ogDescription="Aunt Mabel calls your elderly loved one every morning for a warm check-in — and reaches you live, in seconds, if something's ever wrong. 14 days free."
  gfTag={false}
>
  <Fragment slot="head">
    {/*
      Three JSON-LD blocks. These are read by Google for rich results AND by AI
      answer engines deciding how to describe this service — which is why the
      FAQ answers below repeat the 911-first posture rather than only selling.
      An assistant that summarises us as an emergency service would be doing
      real harm, so the correction is written where the machines read.

      set:html with JSON.stringify, never a raw template string: a stray
      apostrophe in the copy would otherwise produce invalid JSON that fails
      silently — the block simply stops counting, with nothing on screen to show
      for it.
    */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'Aunt Mabel',
        legalName: 'Trustlight LLC',
        url: 'https://auntmabel.app',
        logo: 'https://auntmabel.app/og-image.jpg',
        email: 'Mabel@AuntMabel.app',
        description:
          'Aunt Mabel is a daily wellness check-in call service for elderly people living alone, operated by Trustlight LLC. It was born out of years of disaster response with the Cajun Navy Ground Force, where the same thing turned up after every storm: elderly people, alone.',
        address: { '@type': 'PostalAddress', addressRegion: 'LA', addressCountry: 'US' },
        sameAs: [],
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: 'Aunt Mabel Daily Check-In Calls',
        serviceType: 'Daily wellness check-in calls for elderly people living alone',
        provider: { '@type': 'Organization', name: 'Trustlight LLC' },
        areaServed: 'US',
        description:
          'A warm daily phone call that checks on an elderly loved one’s meals, medications, and wellbeing — with live family escalation (Family Connect) the moment something is wrong.',
        offers: {
          '@type': 'Offer',
          price: '39.00',
          priceCurrency: 'USD',
          description: 'Monthly subscription with a 14-day free trial. Cancel anytime.',
        },
      })}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          [
            'What is Aunt Mabel?',
            'Aunt Mabel is a service that places a warm, friendly phone call to an elderly person living alone every day, checks on their meals, medications, and wellbeing, and reaches their family immediately if something is wrong. It is operated by Trustlight LLC, and grew out of years of disaster-response work with the Cajun Navy Ground Force.',
          ],
          [
            'How does the daily check-in call work?',
            'Every day at a time the family chooses, Aunt Mabel calls the elderly person for a warm conversation — how they slept, whether they’ve eaten, how they’re feeling. The family sees a summary of every call in their dashboard.',
          ],
          [
            'What happens if something is wrong during a call?',
            'Mabel urges the person to call 911 for any emergency, and at the same time reaches their family — bringing a family member onto the call live, so they’re never alone. Aunt Mabel is not an emergency service, and 911 always comes first.',
          ],
          [
            'Is Aunt Mabel a medical or emergency service?',
            'No. Aunt Mabel is a friendly daily check-in and a fast way to reach family — not an emergency service, medical device, or monitoring system. For any real emergency, always call 911.',
          ],
          [
            'How much does Aunt Mabel cost?',
            'Aunt Mabel is $39 per month with a 14-day free trial — you’re not charged until your loved one has truly welcomed Mabel into their mornings. Cancel anytime — the calls carry on to the end of the period you have paid for, then stop, and cancelling during the free trial means you are never charged at all.',
          ],
          [
            'Why does a daily call matter?',
            'Millions of older adults live alone, and many go days at a time without a real conversation. That isolation is not just sad — sustained loneliness is associated with serious declines in physical and mental health, and it is the ordinary Tuesday, not the emergency, when nobody notices something has changed. A daily call is a small, steady thread of connection: someone who asks how they slept, remembers yesterday, and would notice if today sounded different.',
          ],
        ].map(([q, a]) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      })}
    />
    <meta
      name="keywords"
      content="elderly wellness check, senior check-in call, daily call for seniors, elderly parent care, automated senior check-in, check on elderly parents, senior safety service, aging parent monitoring, AI check-in call, daily wellness call, senior isolation, elderly loneliness, companionship for seniors, care for aging parents, remote elderly care, peace of mind for families, scheduled check-in calls, senior social isolation, living alone elderly, daily reassurance call"
    />
    {/*
      REMOVED, deliberately — do not restore:

      1. A second `Service` block naming **Cajun Navy Ground Force as the
         provider**, carrying the nonprofit's own address, email and telephone.
         That is the exact error docs/AUNT-MABEL.md § Entity & naming exists to
         prevent — and it was the MACHINE-READABLE copy, the version Google and
         AI assistants repeat when asked who runs this service. Trustlight LLC
         is the operator; CNGF is the disaster-response partner. The Service
         block above now says so.

      2. geo.placename "Lafayette, Louisiana" and its coordinates. Venue was
         resolved to Orleans Parish, and pinning a nationwide service to a city
         we do not operate from only suppresses it elsewhere. The lighter
         US-LA / Louisiana pair now lives in BaseLayout for every page.
    */}
  </Fragment>

  <div class="hp">
    <section class="hp-hero">
      <div class="hp-hero-copy">
        <div class="hp-badge">
          <span class="dot" aria-hidden="true"></span>
          In partnership with the Cajun Navy Ground Force
        </div>
        <h1>A friendly call every day — and someone there when it matters most.</h1>
        <p class="hp-lede">
          Aunt Mabel calls your elderly loved one every morning for a warm, friendly
          check-in. And if something's ever wrong, she reaches you right away — so
          they're never alone when it counts.
        </p>
        <div class="hp-cta-row">
          <a class="hp-btn hp-btn-lg" href="/enroll">Start their daily calls →</a>
          <span class="hp-fine">14 days free · Cancel anytime</span>
        </div>
      </div>

      <div class="hp-hero-media">
        <div class="hp-photo-frame">
          <img
            class="hp-photo"
            src="/images/hero-family.jpg"
            width="1100"
            height="1375"
            alt="A son kisses his mother's forehead — she smiles, eyes closed, wrapped in a crocheted blanket."
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="hp-call-card">
          <div class="hp-call-head">
            <span class="dot" aria-hidden="true"></span>Today's call · 9:02 am
          </div>
          <p>"She had her oatmeal, took her pills, and the roses are blooming."</p>
        </div>
      </div>
    </section>

    <section class="hp-problem">
      <div class="hp-problem-inner">
        <div class="hp-rule" aria-hidden="true"></div>
        <h2>When did you last hear her voice?</h2>
        <p>
          You meant to call Sunday. Then the week happened. You know she's alone in
          that house — that most days, the phone doesn't ring at all, and she'd never
          tell you how quiet it gets. She doesn't want to be a burden. So she says
          she's fine.
        </p>
        <p>
          Meanwhile you're left wondering. Did she eat today? Did he take his pills?
          And underneath it, the worry you don't say out loud:
          <em>if something happened, would I even know?</em>
        </p>
        <p>
          You can't call every morning. But someone can — someone who listens,
          remembers, and tells you how she's really doing.
        </p>
        <p class="hp-turn">
          Aunt Mabel is there on the days you can't be. Loneliness ends tomorrow
          morning at nine.
        </p>
      </div>
    </section>

    {/*
      MOVED UP 2026-08-10, from between the feature cards and the closing CTA.
      Down there she was the last thing before the ask and most visitors never
      reached her. The service is named after a real woman and carries her face
      as its logo — that is the answer to "who is this?", so it belongs right
      after the reader recognises the worry and before the mechanics of how it
      works.

      Deliberately NOT next to the hero: the hero already carries a photograph
      of a son and his mother, and two portraits competing in the first screen
      made neither of them land.
    */}
    <section class="hp-story hp-story-lead">
      <a class="hp-story-inner" href="/story">
        <img
          src="/images/family/aunt-mabel-face.jpg"
          width="560"
          height="560"
          decoding="async"
          alt="Aunt Mabel — a sepia studio portrait of a smiling woman with dark waved hair and a sparkling brooch."
        />
        <div>
          <p>
            Aunt Mabel was a real person — the founder's great-aunt, who remembered
            every family member's name at every reunion. Her photo is our logo. Her
            spirit is the whole service.
          </p>
          <span class="hp-story-link">Read our story →</span>
        </div>
      </a>
    </section>

    <section id="how" class="hp-how">
      <div class="hp-inner">
        <h2 class="hp-centred">How it works</h2>
        <p class="hp-sub">Three small steps, and then it simply happens every morning.</p>
        <div class="hp-steps">
          <div>
            <div class="hp-num" aria-hidden="true">1</div>
            <h3>Sign up your loved one</h3>
            <p>
              Their name, their phone number, and the time of day they'd most like to
              hear from someone. That's it — nothing for them to set up, download, or
              learn.
            </p>
          </div>
          <div>
            <div class="hp-num" aria-hidden="true">2</div>
            <h3>Mabel calls them every day</h3>
            <p>
              A real conversation, never a robotic script. She asks about their
              morning, remembers what they told her yesterday, and lets them talk as
              long as they'd like.
            </p>
          </div>
          <div>
            <div class="hp-num" aria-hidden="true">3</div>
            <h3>You stay in the loop</h3>
            <p>
              A warm summary of every call lands in your family dashboard. Good days
              are good days — and if something's wrong, you hear about it right away.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/*
      An example of the real dashboard, not an illustration of one. The markup
      below is the call row from src/pages/dashboard/recipient.astro, class
      names included, and the CSS at the foot of this file is the same rules
      from dashboard.css — which the homepage does not load, so they are
      restated rather than imported. They reference the same site.css tokens
      the dashboard does, so a brand change moves both together.

      If the real timeline row ever changes shape, this has to change with it,
      or the homepage starts promising a product that no longer looks like
      this. That is the cost of showing the actual thing; the alternative is a
      drawing of it, which nobody believes.
    */}
    <section id="hp-example" class="hp-example">
      <div class="hp-inner">
        <h2 class="hp-centred">What you'll see each morning.</h2>
        <p class="hp-sub">A short note from Mabel after every check-in.</p>

        <div class="hp-example-panel">
          <div class="call-row">
            <div class="call-when">
              <div class="call-date">Thu, Oct 9</div>
              <div class="call-time">9:04 AM</div>
              <div class="call-dur">6 min</div>
            </div>
            <div class="call-body">
              <div class="call-sentiment">
                <span class="call-dot" aria-hidden="true"></span><span>Positive</span>
              </div>
              <p class="call-summary">
                Dorothy told Mabel about meeting her husband Earl at a dance in 1961 —
                she said she noticed his shoes before she noticed him. She'd slept well
                and had eggs and grits for breakfast.
              </p>
              <div class="call-topics"><span>Love</span><span>Younger days</span></div>
            </div>
          </div>

          <div class="call-row">
            <div class="call-when">
              <div class="call-date">Wed, Oct 8</div>
              <div class="call-time">9:02 AM</div>
              <div class="call-dur">5 min</div>
            </div>
            <div class="call-body">
              <div class="call-sentiment">
                <span class="call-dot" aria-hidden="true"></span><span>Positive</span>
              </div>
              <p class="call-summary">
                Mabel and Dorothy talked about the tomatoes coming in and the heat
                holding on longer than it should. Dorothy mentioned her neighbor
                brought her a pie.
              </p>
              <div class="call-topics">
                <span>Home</span><span>Food and the kitchen</span>
              </div>
            </div>
          </div>

          <div class="call-row flagged">
            <div class="call-when">
              <div class="call-date">Tue, Oct 7</div>
              <div class="call-time">9:01 AM</div>
              <div class="call-dur">7 min</div>
            </div>
            <div class="call-body">
              <div class="call-sentiment">
                <span class="call-dot flag" aria-hidden="true"></span><span>Worth a look</span>
              </div>
              <p class="call-summary">
                Dorothy said her air conditioner has been struggling and the house is
                warmer than she'd like. She didn't want to bother anyone about it.
              </p>
              <div class="call-topics"><span>Home</span></div>
            </div>
          </div>
        </div>

        <p class="hp-example-note">Names and details here are an example, not a real family.</p>
      </div>
    </section>

    <section class="hp-features">
      <div class="hp-inner hp-stack">
        <div class="hp-panel hp-split">
          <div>
            <div class="hp-eyebrow">Every morning</div>
            <h3 class="hp-panel-h">A warm daily check-in</h3>
            <p>
              It feels like a visit from a friend, not a questionnaire. Mabel gently
              makes sure they've eaten, taken their medicine, and slept alright — and
              then she stays for the part that matters just as much: the company.
            </p>
          </div>
          <div class="hp-quote-card">
            <p class="hp-quote">"Morning, Ruth. Did you get to your coffee before the crossword this time?"</p>
            <div class="hp-hair" aria-hidden="true"></div>
            <div class="hp-tags">
              <span>Meals</span><span>Medication</span><span>Mood</span><span>Company</span>
            </div>

            <!--
              Sample call player. Starts HIDDEN and is revealed only once the
              audio file is confirmed to exist — the recording is added later,
              and a play button that does nothing is worse than no player at
              all. See the script at the foot of this file.
            -->
            <div class="hp-audio" id="sample-call" hidden>
              <div class="hp-hair" aria-hidden="true"></div>
              <div class="hp-audio-row">
                <button class="hp-play" id="sample-play" type="button" aria-label="Play the sample call">
                  <span class="hp-play-tri" aria-hidden="true"></span>
                  <span class="hp-play-bars" aria-hidden="true"><i></i><i></i></span>
                </button>
                <div class="hp-audio-body">
                  <div class="hp-audio-label">Listen in — a morning call with Mabel</div>
                  <div class="hp-audio-bar" id="sample-bar" aria-hidden="true"><span></span></div>
                </div>
                <div class="hp-audio-time" id="sample-time">0:00</div>
              </div>
              <!-- preload="none": most visitors never press play. -->
              <audio id="sample-audio" preload="none" src="/audio/sample-call.mp3"></audio>
            </div>
          </div>
        </div>

        <div id="family-connect" class="hp-connect">
          <div>
            <div class="hp-badge hp-badge-on-rose">
              <span class="dot gold" aria-hidden="true"></span>Family Connect
            </div>
            <h3>She reaches you the moment it matters.</h3>
            <p>
              If your loved one is ever in distress — a fall, chest pain, confusion, a
              scare — Mabel doesn't wait until tomorrow. She urges them to call 911,
              and in the same breath she reaches you, right then, bringing you onto the
              call live.
            </p>
            {/*
              ⚠️ COPY ACCURACY. This says EMAILS, not calls. Both channels named
              here really fire: sendFamilyAlert() addresses the account holder
              and every emergency contact with an email on file, on a flagged
              call and on a second no-answer.

              There is NO alert phone call — that is Family Connect Part 3 on
              the roadmap. Do not add "she calls you" until it exists.

              An Astro comment, not an HTML one: this note is for us, and a
              <!-- --> comment is served to every visitor.
            */}
            <p class="hp-connect-alert">
              And if she simply hears something concerning — a fall she mentions in
              passing, confusion, a bad day — she doesn't just note it. She emails you
              and your emergency contact right away, and it's waiting at the top of
              your dashboard. You're never the last to know.
            </p>
            <p class="hp-connect-turn">
              So a frightened parent is never alone — and you're there in seconds.
            </p>
            <p class="hp-connect-fine">For real emergencies, 911 always comes first.</p>
          </div>

          <div class="hp-live-card">
            <div class="hp-live-head">
              <span class="dot rose" aria-hidden="true"></span>Live now · 7:41 am
            </div>
            <div class="hp-live-lines">
              <div class="hp-live-msg">
                Mabel: "Ruth, I want you to hang up and call 911 for me, alright? I'm
                getting your daughter on the line right now."
              </div>
              <div class="hp-live-call">
                <div class="hp-live-label">Calling Sarah — daughter</div>
                <span class="hp-live-join">Joining the call…</span>
              </div>
            </div>
          </div>
        </div>

        <div class="hp-cards">
          <div class="hp-panel">
            <div class="hp-icon"><span class="sq sage" aria-hidden="true"></span></div>
            <h3 class="hp-card-h">A dashboard that gives you peace of mind</h3>
            <p>
              Every call, in plain language. A warm summary of how they're doing, a
              calendar of good days you can see at a glance, and anything that concerns
              her waiting right at the top.
            </p>
          </div>
          <div class="hp-panel">
            <div class="hp-icon"><span class="circ gold" aria-hidden="true"></span></div>
            <h3 class="hp-card-h">Flags when something needs attention</h3>
            <!--
              ⚠️ Same accuracy note as the Family Connect block above. The line
              this replaced said "You and the emergency contact you choose are
              told", which no code path does today — flag alerts reach the Aunt
              Mabel team's inbox only. Restore the stronger wording once the
              customer and their contacts are genuinely on the alert email.
            -->
            <p>
              Meals skipped, a missed call, a sadness that lingers, a fall she mentions
              in passing. The day it happens, an email goes to you and to the emergency
              contact you chose — and it's waiting at the top of your dashboard too.
            </p>
          </div>
          {/*
            REMOVED 2026-08-10 — do not restore without the capability behind it.
            A third card here promised "A knock on the door when disaster
            strikes": an in-person check by the Cajun Navy Ground Force when a
            storm hit a recipient's area. We cannot deliver that today, and a
            family choosing this service partly for that reason would be
            choosing something that does not exist.

            The partnership itself stays everywhere it appears — as heritage and
            motivation, which is true. It is the OPERATIONAL promise that went.
          */}
        </div>
      </div>
    </section>

    <section class="hp-honest">
      <div class="hp-honest-inner">
        <h2>What Aunt Mabel is — and what she isn't.</h2>
        <p>
          Aunt Mabel is a friendly daily check-in and a fast way to reach family. She
          is <strong>not</strong> an emergency service, a medical device, or a
          monitoring system, and she is not a substitute for care or for calling for
          help.
        </p>
        <p>For any real emergency, always call 911 first.</p>
        <p class="hp-honest-turn">
          We'll always be honest with you about what we can and can't promise. That's
          the only way this works.
        </p>
      </div>
    </section>

    <section id="start" class="hp-start">
      <div class="hp-start-inner">
        <div>
          <h2>Be one of our founding families.</h2>
          <p>
            Born from years of disaster response, where we saw the same thing after
            every storm: elderly people, alone. Aunt Mabel is our answer to the
            loneliness that's there every ordinary day.
          </p>
          <a class="hp-btn hp-btn-lg" href="/enroll">Start their daily calls →</a>
        </div>
        <div class="hp-start-list">
          <div>
            <span class="dot green" aria-hidden="true"></span>
            <p><strong>14 days free.</strong> You're not charged until they've truly welcomed Mabel into their mornings.</p>
          </div>
          <div>
            <span class="dot gold" aria-hidden="true"></span>
            <p><strong>Founding family rate</strong> with code <code>FOUNDING</code> — yours for as long as you stay.</p>
          </div>
          <div class="last">
            <span class="dot rose" aria-hidden="true"></span>
            <p><strong>Cancel anytime.</strong> Calls carry on to the end of the period you've paid for, then stop.</p>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Homepage — values transcribed from the Claude Design mockup. Colours are
     the mockup's literal hex codes, which are the same brand palette site.css
     defines as custom properties; kept literal here so this file can be diffed
     against the mockup line for line. */

  .hp { background: #f6efe2; color: #2d2417; font-weight: 300; }
  .hp p { text-wrap: pretty; }

  .hp-btn {
    display: inline-block;
    background: #c25b50;
    color: #fbf7ee !important;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .hp-btn:hover { background: #a3463d; color: #fbf7ee !important; }
  .hp-btn-sm { padding: 10px 18px; font-size: 14px; letter-spacing: 0.01em; }
  .hp-btn-lg { padding: 17px 30px; font-size: 17px; box-shadow: 0 10px 26px -14px rgba(194, 91, 80, 0.9); }

  /* ── hero ─────────────────────────────────────────────────────────── */
  .hp-hero {
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 88px) 28px clamp(40px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }
  .hp-hero-copy { max-width: 600px; }

  .hp-badge {
    display: inline-flex; align-items: center; gap: 9px;
    border: 1px solid #e3d8c3; background: #fbf7ee; border-radius: 999px;
    padding: 7px 14px 7px 10px;
    font-size: 12.5px; letter-spacing: 0.03em; text-transform: uppercase;
    color: #6f7d5e; margin-bottom: 26px;
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #7ab648; display: block; flex: none; }
  .dot.gold { background: #d9a441; }
  .dot.rose { background: #c25b50; width: 8px; height: 8px; }
  .dot.green { background: #7ab648; }

  .hp-hero h1 {
    font-family: Fraunces, Georgia, serif;
    font-weight: 600;
    font-size: clamp(38px, 5.1vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 0 0 22px;
  }
  .hp-lede {
    font-size: clamp(17px, 1.5vw, 19.5px);
    line-height: 1.65;
    color: #6b5d48;
    margin: 0 0 32px;
    max-width: 520px;
  }
  .hp-cta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .hp-fine { font-size: 14px; color: #6b5d48; }

  .hp-hero-media { position: relative; }
  .hp-photo-frame {
    border-radius: 20px; overflow: hidden;
