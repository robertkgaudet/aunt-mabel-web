---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Signing out… · Aunt Mabel" noindex={true} bare={true}>
  <div class="auth-page">
    <div class="auth-card centered">
      <p class="subhead" style="margin:0">Signing you out…</p>
    </div>
  </div>
</BaseLayout>

<script>
  import { signOutCleanly } from '../scripts/auth.js';

  (async () => {
    await signOutCleanly();
    window.location.replace('/');
  })();
</script>
